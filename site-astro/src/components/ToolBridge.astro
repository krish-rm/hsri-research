---
// ToolBridge.astro — Non-bouncing gateway connecting narrative chapters to deep verification tools
interface Props {
  eyebrow: string;
  title: string;
  desc: string;
  href: string;
  cta: string;
  variant?: 'seismograph' | 'drill' | 'reinsurance';
}

const {
  eyebrow,
  title,
  desc,
  href,
  cta,
  variant = 'seismograph'
} = Astro.props;
---

<div class={`tool-bridge-card variant-${variant}`}>
  <div class="bridge-content">
    <span class="bridge-eyebrow">{eyebrow}</span>
    <h4 class="bridge-title">{title}</h4>
    <p class="bridge-desc">{desc}</p>
  </div>
  <div class="bridge-action">
    <a href={href} class="btn-bridge">
      {cta}
    </a>
  </div>
</div>

<style>
  .tool-bridge-card {
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .tool-bridge-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .bridge-content {
    flex: 1;
  }

  .bridge-eyebrow {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
  }

  .bridge-title {
    margin: 0 0 0.35rem 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .bridge-desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .bridge-action {
    flex-shrink: 0;
  }

  .btn-bridge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    background: var(--accent-primary);
    color: #ffffff;
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-bridge:hover {
    background: var(--accent-primary-hover);
    box-shadow: 0 0 12px var(--accent-primary-glow);
  }

  /* Specific Variants */
  .variant-seismograph {
    border-left: 4px solid var(--threat-telemetry);
  }
  .variant-drill {
    border-left: 4px solid var(--threat-warning);
  }
  .variant-reinsurance {
    border-left: 4px solid var(--threat-sovereign);
  }

  @media (max-width: 680px) {
    .tool-bridge-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
