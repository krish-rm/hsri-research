---
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from './HSRIHeader.svelte';
import HeroStory from './HeroStory.svelte';
import FiveDoorsPreview from './FiveDoorsPreview.svelte';
import CountryCatchWidget from './CountryCatchWidget.svelte';
import HumanitysPulseSection from './HumanitysPulseSection.svelte';
import GoDeeperSection from './GoDeeperSection.svelte';
import HSRIFooter from './HSRIFooter.svelte';
import precursorSummary from '../data/precursor_summary.json';
import { buildCountryWidgetCatalog } from '../lib/countryData';
import { COUNTRY_SKIES } from '../lib/countrySkies';
import { ISO3_TO_ISO2, getLocaleMeta, type LocaleCode } from '../i18n/locales';
import heritageIndex from '../data/heritage/index.json';
import { SERVER_DICTS, SERVER_STORIES } from '../i18n/registry';
import {
  buildHomeJsonLd,
  getCountryNameInLocale,
  getHomepageAlternates,
  normalizeCanonicalUrl,
  OG_LOCALE_BY_LANG,
  SEO_KEYWORDS_BY_LANG
} from '../lib/seo';

interface Props {
  lang?: LocaleCode;
}

const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const activeDict = SERVER_DICTS[lang] ?? SERVER_DICTS.en;
const activeStoryPack = lang === 'en' ? undefined : SERVER_STORIES[lang];
const localeMeta = getLocaleMeta(lang);
const isNonEn = lang !== 'en';

const canonicalUrl = normalizeCanonicalUrl(Astro.url.href, Astro.url.pathname);
const alternates = getHomepageAlternates();
const homeJsonLd = buildHomeJsonLd(
  lang,
  activeDict.meta.title,
  activeDict.meta.description,
  canonicalUrl
);

const headerSsrDict = isNonEn ? { headerUi: activeDict.headerUi } : undefined;
const heroSsrDict = isNonEn
  ? {
      hero: activeDict.hero,
      totoCard: activeDict.totoCard,
      heritageUi: activeDict.heritageUi,
      totoBeats: activeDict.totoBeats,
      totoIntro: activeDict.totoIntro
    }
  : undefined;
const doorsSsrDict = isNonEn
  ? {
      doors: activeDict.doors,
      heritageUi: activeDict.heritageUi,
      hero: activeDict.hero,
      player: activeDict.player,
      trial: activeDict.trial,
      shadowCard: activeDict.shadowCard,
      lights: activeDict.lights
    }
  : undefined;
const countrySsrDict = isNonEn
  ? {
      country: activeDict.country,
      heritageUi: activeDict.heritageUi,
      doors: activeDict.doors
    }
  : undefined;
const pulseSsrDict = isNonEn ? { pulse: activeDict.pulse } : undefined;
const deeperSsrDict = isNonEn ? { deeper: activeDict.deeper } : undefined;
const footerSsrDict = isNonEn ? { footer: activeDict.footer } : undefined;

const rawPulseScore = Number(precursorSummary.master_precursor_threat_score ?? 8.44);
const pulseKey: 'steady' | 'stirring' | 'rising' =
  rawPulseScore < 4.0 ? 'steady' : rawPulseScore < 7.0 ? 'stirring' : 'rising';

const starterIsos = new Set([
  'NOR', 'DEU', 'JPN', 'USA', 'SGP', 'BRA', 'IND', 'NGA',
  'ARE', 'GBR', 'FRA', 'CAN', 'AUS', 'EGY', 'SAU', 'KEN',
  'ZAF', 'IDN', 'KOR', 'CHN', 'MEX', 'TUR', 'PAK', 'BGD',
  'NPL', 'PHL', 'THA', 'VNM'
]);
const fullCountryCatalog = buildCountryWidgetCatalog();
const countryCatalog = fullCountryCatalog.filter((c) => starterIsos.has(c.iso));

// Compact 148-country pre-paint detection index derived from single sources of truth
const skyByIso = new Map(COUNTRY_SKIES.filter((s) => s.iso !== 'GLOBAL').map((s) => [s.iso, s]));
const autoSkyRows = COUNTRY_SKIES.filter((s) => s.iso !== 'GLOBAL').map((s) => [
  s.id,
  s.iso,
  getCountryNameInLocale(s.iso, s.country, lang),
  activeDict.hero.regionGroups[s.regionHint] ?? s.regionHint,
  s.painted ? 1 : 0,
  ...s.tzPrefixes
]);
const autoIso2: Record<string, string> = { UK: 'gbr' };
for (const [iso3, iso2] of Object.entries(ISO3_TO_ISO2)) {
  const sky = skyByIso.get(iso3);
  if (sky) autoIso2[iso2] = sky.id;
}
const autoFullNames: Record<string, string> = {};
for (const c of fullCountryCatalog) {
  const sky = skyByIso.get(c.iso);
  const locFull = getCountryNameInLocale(c.iso, c.name, lang);
  const locShort = sky ? getCountryNameInLocale(sky.iso, sky.country, lang) : '';
  if (!sky || locFull !== locShort) autoFullNames[c.iso] = locFull;
}
const autoTraditions: Record<string, string> = {};
for (const h of heritageIndex) {
  const packLabel = activeStoryPack?.heritageMeta?.[h.id]?.traditionLabel;
  const baseLabel =
    lang === 'es' ? h.traditionLabel.es : lang === 'ar' ? h.traditionLabel.ar : h.traditionLabel.en;
  const localizedLabel = packLabel || baseLabel || h.traditionLabel.en;
  for (const iso of h.countries) {
    if (!autoTraditions[iso]) autoTraditions[iso] = localizedLabel;
  }
}
const geoData = {
  lang,
  rows: autoSkyRows,
  iso2: autoIso2,
  full: autoFullNames,
  trad: autoTraditions,
  exploreTpl: activeDict.heritageUi.exploreCountryBtn,
  catchCtaTpl: activeDict.heritageUi.seeCatchCountryBtn,
  perspTradTpl: activeDict.heritageUi.countryHeadingTradition,
  perspGlobTpl: activeDict.heritageUi.countryHeadingGlobal,
  perspSubTpl: activeDict.heritageUi.countrySubhead,
  catchHeadTpl: activeDict.heritageUi.countryCatchHeading,
  checkingNote: activeDict.country.checkingBaseline
};
---

<BaseLayout
  title={activeDict.meta.title}
  description={activeDict.meta.description}
  keywords={SEO_KEYWORDS_BY_LANG[lang]}
  lang={lang}
  dir={localeMeta.dir}
  ogLocale={OG_LOCALE_BY_LANG[lang]}
  canonicalUrl={canonicalUrl}
  alternates={alternates}
  structuredData={homeJsonLd}
>
  <HSRIHeader
    client:interact
    currentPath={Astro.url.pathname}
    showStatsBar={false}
    ssrLocale={lang}
    ssrDict={headerSsrDict}
  />

  <main class="story-canvas">
    <!-- STEP 1: CLEAN SINGLE-SCREEN HERO -->
    <HeroStory client:interact base={base} ssrLocale={lang} ssrDict={heroSsrDict} />
    <script is:inline define:vars={{ geoData }}>
      try {
        var _p = new URLSearchParams(window.location.search);
        var _uLang = _p.get("lang");
        var _sLoc = localStorage.getItem("hr:v1:locale");
        var _isPageLocale = _uLang ? _uLang === geoData.lang : (!_sLoc || _sLoc === geoData.lang);
        var _cParam = (_p.get("c") || "").trim().toLowerCase();
        var rows = geoData.rows || [];
        var matched = null;
        if (_cParam) {
          for (var i = 0; i < rows.length; i++) {
            if (rows[i][0] === _cParam || rows[i][1].toLowerCase() === _cParam) { matched = rows[i]; break; }
          }
        }
        if (!matched) {
          var tz = "";
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) {}
          if (tz) {
            for (var i = 0; i < rows.length && !matched; i++) {
              var r = rows[i];
              for (var j = 5; j < r.length; j++) {
                if (tz.indexOf(r[j]) === 0) { matched = r; break; }
              }
            }
          }
        }
        if (!matched) {
          var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]) || [];
          for (var k = 0; k < langs.length && !matched; k++) {
            var tag = langs[k] || "";
            var parts = tag.split(/[-_]/);
            var reg = "";
            for (var q = 1; q < parts.length; q++) {
              if (/^[A-Za-z]{2}$/.test(parts[q])) { reg = parts[q].toUpperCase(); break; }
            }
            var idHit = reg ? geoData.iso2[reg] : "";
            if (idHit) {
              for (var m = 0; m < rows.length; m++) {
                if (rows[m][0] === idHit) { matched = rows[m]; break; }
              }
            }
          }
        }
        if (matched) {
          var id = matched[0], iso = matched[1], co = matched[2], regHint = matched[3], painted = matched[4];
          var fullCo = geoData.full[iso] || co;
          var tradCo = geoData.trad[iso] || "";
          window.__hc = id;
          window.__hcIso = iso;
          window.__hrAutoCountry = {
            id: id,
            iso: iso,
            co: co,
            fullCo: fullCo,
            trad: tradCo,
            isEn: _isPageLocale,
            isPageLocale: _isPageLocale,
            perspTitle: tradCo
              ? geoData.perspTradTpl.replace("{country}", co).replace("{tradition}", tradCo)
              : geoData.perspGlobTpl.replace("{country}", co),
            perspSub: geoData.perspSubTpl.replace("{country}", co),
            catchHead: geoData.catchHeadTpl.replace("{country}", fullCo),
            checkingText: fullCo + " (" + iso + ") · " + geoData.checkingNote
          };
          var sel = document.getElementById("hero-city-select"),
              bg = document.getElementById("hero-city-bg"),
              cn = document.getElementById("hcn"),
              cr = document.getElementById("hcr"),
              cue = document.getElementById("hero-cue-country"),
              c1 = document.getElementById("hero-cta-primary-label"),
              c2 = document.getElementById("hero-cta-secondary-label");
          if (sel) {
            sel.value = id;
            if (_isPageLocale && sel.selectedIndex >= 0) {
              var lbl = sel.options[sel.selectedIndex].text;
              if (cn) cn.textContent = lbl;
              if (cue) cue.textContent = co;
              if (c1) c1.textContent = geoData.exploreTpl.replace("{country}", co);
              if (c2) c2.textContent = geoData.catchCtaTpl.replace("{country}", co);
            }
          }
          if (_isPageLocale && cr) cr.textContent = regHint;
          if (bg) {
            var f = painted ? id : "dawn-sky-base";
            bg.setAttribute("src", (bg.getAttribute("src") || "").replace(/\/assets\/cities\/[^.]+\.webp/, "/assets/cities/" + f + ".webp"));
          }
        }
      } catch (e) {}
    </script>

    <!-- STEP 2: 60-SECOND BREAKTHROUGH EXPLORER & COMPACT 5 LIGHTS -->
    <FiveDoorsPreview
      client:interact
      base={base}
      ssrLocale={lang}
      ssrDict={doorsSsrDict}
      ssrStoryOverlay={activeStoryPack}
    />

    <!-- STEP 3: COMPACT COUNTRY READINESS SNAPSHOT -->
    <CountryCatchWidget
      client:interact
      countries={countryCatalog}
      base={base}
      ssrLocale={lang}
      ssrDict={countrySsrDict}
      ssrStoryOverlay={activeStoryPack}
    />
    <script is:inline>
      try {
        var _d = window.__hrAutoCountry;
        if (_d && _d.isPageLocale) {
          var dt = document.getElementById("doors-sec-title");
          var ds = document.getElementById("doors-sec-sub");
          if (dt) dt.textContent = _d.perspTitle;
          if (ds) ds.textContent = _d.perspSub;
          var ch = document.getElementById("country-check-heading");
          if (ch) ch.textContent = _d.catchHead;
          var csel = document.getElementById("country-select");
          if (csel) {
            for (var i = 0; i < csel.options.length; i++) {
              if (csel.options[i].value === _d.iso) { csel.value = _d.iso; break; }
            }
          }
          if (_d.iso !== "NOR") {
            var box = document.querySelector("#country-check .compact-country-box");
            if (box) {
              var pMsg = box.querySelector(".cc-prepaint-pending");
              if (pMsg) pMsg.textContent = _d.checkingText;
              box.setAttribute("data-prepaint-pending", "true");
            }
          }
        }
      } catch (e) {}
    </script>

    <!-- STEP 4: HUMANITY'S PULSE (Just Above Research Section) -->
    <HumanitysPulseSection
      client:interact
      base={base}
      pulseKey={pulseKey}
      pulseScore={rawPulseScore}
      ssrLocale={lang}
      ssrDict={pulseSsrDict}
    />

    <!-- COMPACT RESEARCH & STORIES BAR -->
    <GoDeeperSection client:interact base={base} ssrLocale={lang} ssrDict={deeperSsrDict} />
  </main>

  <HSRIFooter client:interact ssrLocale={lang} ssrDict={footerSsrDict} />
</BaseLayout>

<style>
  .story-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }
</style>
