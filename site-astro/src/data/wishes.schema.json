{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanityreadiness.org/schemas/wishes.schema.json",
  "$comment": "Internal filename wishes.schema.json preserved from Phase 2 for hr:v1:* compatibility; validates Humanity Readiness breakthrough records.",
  "title": "Humanity Readiness Breakthrough Collection",
  "type": "array",
  "minItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "door",
      "order",
      "icon",
      "status",
      "title",
      "doorTitle",
      "honestyLabel",
      "honestyNote",
      "verbatimFromBrief",
      "shadowTag",
      "atlasRefs",
      "wonder",
      "wobble",
      "weight",
      "way",
      "closingLine",
      "realityMeter"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "door": {
        "type": "string",
        "enum": ["mysteries", "gadgets", "epic", "movie", "world"],
        "description": "Internal domain key (maps to Five domains: Open Problems, Everyday Technologies, Transformative Powers, Culture & Creativity, Public Good)"
      },
      "order": { "type": "integer", "minimum": 1 },
      "icon": { "type": "string", "enum": ["chalkboard", "pocket", "eye", "frame", "lamp"] },
      "status": { "type": "string", "enum": ["DRAFT", "reviewed"] },
      "title": { "$ref": "#/$defs/localizedText" },
      "doorTitle": { "$ref": "#/$defs/localizedText" },
      "honestyLabel": { "type": "string", "enum": ["Imagination", "Possible soon", "Real today"] },
      "honestyNote": { "$ref": "#/$defs/localizedText" },
      "verbatimFromBrief": { "type": "boolean" },
      "shadowTag": { "type": "string", "enum": ["Control", "Dependence", "Power", "Truth", "Speed"] },
      "atlasRefs": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^SC-\\d{2}$" }
      },
      "wonder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "totoLine", "transcript", "draft"],
        "properties": {
          "text": { "$ref": "#/$defs/localizedText" },
          "totoLine": { "$ref": "#/$defs/localizedText" },
          "transcript": { "$ref": "#/$defs/localizedText" },
          "draft": { "type": "boolean" }
        }
      },
      "wobble": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "transcript", "draft"],
        "properties": {
          "text": { "$ref": "#/$defs/localizedText" },
          "transcript": { "$ref": "#/$defs/localizedText" },
          "draft": { "type": "boolean" }
        }
      },
      "weight": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "transcript", "draft", "options"],
        "properties": {
          "question": { "$ref": "#/$defs/localizedText" },
          "transcript": { "$ref": "#/$defs/localizedText" },
          "draft": { "type": "boolean" },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "light", "shadow"],
              "properties": {
                "id": { "type": "string", "enum": ["a", "b", "c"] },
                "text": { "$ref": "#/$defs/localizedText" },
                "light": {
                  "type": "string",
                  "enum": ["Clarity", "Foresight", "Fairness", "Wisdom", "Capability"]
                },
                "shadow": {
                  "type": "string",
                  "enum": ["Control", "Dependence", "Power", "Truth", "Speed"]
                }
              }
            }
          }
        }
      },
      "way": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "actionCardTitle", "actionCardStep", "pledgeLabel", "transcript", "draft"],
        "properties": {
          "text": { "$ref": "#/$defs/localizedText" },
          "actionCardTitle": { "$ref": "#/$defs/localizedText" },
          "actionCardStep": { "$ref": "#/$defs/localizedText" },
          "pledgeLabel": { "$ref": "#/$defs/localizedText" },
          "transcript": { "$ref": "#/$defs/localizedText" },
          "draft": { "type": "boolean" }
        }
      },
      "closingLine": { "type": "string", "const": "Every great breakthrough needs a ready world." },
      "realityMeter": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "isConservativeBaseline", "statusLabel", "note", "source", "sourceUrl", "lastReviewed"],
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "isConservativeBaseline": { "type": "boolean" },
          "statusLabel": { "$ref": "#/$defs/localizedText" },
          "note": { "$ref": "#/$defs/localizedText" },
          "source": { "type": "string", "minLength": 5 },
          "sourceUrl": { "type": "string", "minLength": 1 },
          "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es", "ar"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "es": { "type": "string", "minLength": 1 },
        "ar": { "type": "string", "minLength": 1 }
      }
    }
  }
}
