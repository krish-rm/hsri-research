---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  keywords?: string;
}

const {
  title = "Humanity Readiness: are we ready to receive what we're wishing for? | Humanity Superintelligence Readiness Index",
  description = "Imagine a superintelligence offers you one wish. Pick it, watch it come true, and see what it would really take. Backed by open research across 39 benchmark nations.",
  image = "https://humanityreadiness.org/assets/og-image.png",
  canonicalUrl = Astro.url ? Astro.url.href : "https://humanityreadiness.org/",
  keywords = "humanity readiness, AI readiness, superintelligence, country preparedness, human oversight, open research"
} = Astro.props;

// Ensure absolute URL for image (WhatsApp and social scrapers strictly require absolute https URLs)
const siteOrigin = "https://humanityreadiness.org";
const ogImageUrl = image.startsWith("http") ? image : `${siteOrigin}${image.startsWith("/") ? "" : "/"}${image}`;
const ogPageUrl = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteOrigin}${canonicalUrl.startsWith("/") ? "" : "/"}${canonicalUrl}`;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Canonical Domain Redirect: humanreadinessindex.org -> humanityreadiness.org -->
    <script is:inline>
      if (window.location.hostname === 'humanreadinessindex.org' || window.location.hostname === 'www.humanreadinessindex.org') {
        window.location.replace('https://humanityreadiness.org' + window.location.pathname + window.location.search + window.location.hash);
      }
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <link rel="canonical" href={ogPageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <style is:inline>
      @font-face {
        font-family: 'Boldonse';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url(https://fonts.gstatic.com/s/boldonse/v1/ZgNQjPxGPbbJUZemjB37jGA.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 800;
        font-display: optional;
        src: url(https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 600 700;
        font-display: optional;
        src: url(https://fonts.gstatic.com/s/jetbrainsmono/v24/tDbv2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKwBNntkaToggR7BYRbKPxDcwg.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    </style>

    <!-- Search Engine Indexing & Bot Permissions -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <!-- Primary Meta Tags -->
    <meta name="title" content={title}>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <meta name="author" content="HSRI Research Consortium">

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Humanity Superintelligence Readiness Index (HSRI 2.0)">
    <meta property="og:url" content={ogPageUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:secure_url" content={ogImageUrl}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Humanity Superintelligence Readiness Index (HSRI 2.0) — Sovereign Sentinel & ASI Precursor Seismograph">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={ogPageUrl}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>
    <meta name="twitter:image:alt" content="HSRI 2.0 — Sovereign Sentinel & ASI Precursor Seismograph">

    <!-- Theme & Locale Direction Initialization (Zero-FOUT) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('hsri-theme');
          const theme = savedTheme === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
          const savedLocale = localStorage.getItem('hr:v1:locale');
          const isRtl = savedLocale === 'ar' || savedLocale === 'rtl-stub';
          document.documentElement.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
          document.documentElement.setAttribute('lang', savedLocale === 'es' || savedLocale === 'ar' ? savedLocale : 'en');
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('dir', 'ltr');
          document.documentElement.setAttribute('lang', 'en');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
