---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Human Superintelligence Readiness Index (HSRI 2.0)",
  description = "Planetary stress-test and real-time precursor seismograph measuring sovereign resilience, human verification limits, and civilizational decoupling across 39 nations.",
  image = "https://humanreadinessindex.org/assets/og-image.png",
  canonicalUrl = Astro.url ? Astro.url.href : "https://humanreadinessindex.org/"
} = Astro.props;

// Ensure absolute URL for image (WhatsApp and social scrapers strictly require absolute https URLs)
const siteOrigin = "https://humanreadinessindex.org";
const ogImageUrl = image.startsWith("http") ? image : `${siteOrigin}${image.startsWith("/") ? "" : "/"}${image}`;
const ogPageUrl = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteOrigin}${canonicalUrl.startsWith("/") ? "" : "/"}${canonicalUrl}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <link rel="canonical" href={ogPageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Boldonse&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Primary Meta Tags -->
    <meta name="title" content={title}>
    <meta name="description" content={description}>
    <meta name="keywords" content="AI readiness, superintelligence, ASI, sovereignty sentinel, verification latency wedge, seismograph, econometrics, AI governance, open science">
    <meta name="author" content="HSRI Research Consortium">

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Human Superintelligence Readiness Index (HSRI 2.0)">
    <meta property="og:url" content={ogPageUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:secure_url" content={ogImageUrl}>
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Human Superintelligence Readiness Index (HSRI 2.0) — Sovereign Sentinel & ASI Precursor Seismograph">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content={ogPageUrl}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageUrl}>
    <meta name="twitter:image:alt" content="HSRI 2.0 — Sovereign Sentinel & ASI Precursor Seismograph">

    <!-- Theme Initialization (Zero-FOUT) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('hsri-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme || (prefersDark ? 'dark' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
