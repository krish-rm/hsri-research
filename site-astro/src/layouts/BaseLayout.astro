---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Human Superintelligence Readiness Index (HSRI)" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/favicon.svg`} />
    <meta name="generator" data astro-cid-j7pv25ns="">

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Meta tags -->
    <meta name="description" content="A research feasibility project investigating whether human psychological and behavioral readiness for increasingly capable AI can be scientifically measured.">
    <meta name="keywords" content="AI, human readiness, superintelligence, index, research">
    <meta name="author" content="HSRI Research Team">

    <!-- Open Graph -->
    <meta property="og:title" content="Human Superintelligence Readiness Index (HSRI)">
    <meta property="og:description" content="Measuring human readiness for increasingly capable AI systems">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://humanreadinessindex.org">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Human Superintelligence Readiness Index (HSRI)">
    <meta name="twitter:description" content="Measuring human readiness for increasingly capable AI systems">
    <!-- Theme Initialization (Zero-FOUT) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('hsri-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = savedTheme || (prefersDark ? 'dark' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Analytics placeholder
    </script>
  </body>
</html>