---
import HSRILayout from '../layouts/HSRILayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import ReinsurancePricingCalculator from '../components/ReinsurancePricingCalculator.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
---

<HSRILayout title="Reinsurance & Sovereign Risk Underwriting Telemetry — HSRI 2.0 Benchmark">
  <div class="reinsurance-page">
    <HSRIHeader client:load currentPath={Astro.url.pathname} />

    <div class="page-intro container">
      <div class="breadcrumb">
        <a href="/">Home</a> &rsaquo; <span>Institutional</span> &rsaquo; <span>Reinsurance Risk</span>
      </div>
    </div>

    <main class="page-content container">
      <ReinsurancePricingCalculator client:load />
    </main>

    <HSRIFooter client:load />
  </div>
</HSRILayout>

<style>
  .reinsurance-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #020617;
    color: #f8fafc;
  }

  .container {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-intro {
    padding-top: 1.5rem;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: #64748b;
  }

  .breadcrumb a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: #38bdf8;
  }

  .breadcrumb span {
    color: #cbd5e1;
  }

  .page-content {
    flex: 1;
    padding-top: 1rem;
    padding-bottom: 3rem;
  }
</style>
