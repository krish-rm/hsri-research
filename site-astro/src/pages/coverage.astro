    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    vertical-align: middle;
  }

  .unrated-table tr:hover {
    background: #f8fafc;
  }

  .iso-badge {
    background: #f1f5f9;
    color: #0f172a;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .subregion-text {
    color: #64748b;
    font-size: 0.8rem;
  }

  .pillar-tag {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .tag-1 { background: #fee2e2; color: #991b1b; }
  .tag-2 { background: #fef3c7; color: #92400e; }
  .tag-3 { background: #e0e7ff; color: #3730a3; }
  .tag-4 { background: #dcfce7; color: #166534; }

  .gap-code {
    background: #f1f5f9;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #475569;
  }

  .notes-cell {
    font-size: 0.8rem;
    color: #64748b;
