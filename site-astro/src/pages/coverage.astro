    color: #64748b;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .region-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .region-pill {
    background: white;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .region-name {
    font-weight: 600;
    color: #1e293b;
  }

  .region-count {
    background: #f1f5f9;
    color: #475569;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Table Section */
  .table-section {
    margin-bottom: 3.5rem;
  }

  .table-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .table-header-bar h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.25rem;
  }

  .table-header-bar p {
    color: #64748b;
    font-size: 0.9rem;
    margin: 0;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0f172a;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-download:hover {
    background: #1e293b;
  }

  .table-responsive {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
