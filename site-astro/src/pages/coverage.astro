---
import fs from 'node:fs';
import path from 'node:path';
import HSRILayout from '../layouts/HSRILayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface UnratedNation {
  country_iso3: string;
  country_name: string;
  region: string;
  un_subregion: string;
  available_pillars: number;
  missing_pillars: string;
  primary_data_gap: string;
  partial_coverage_notes: string;
}

// Read unrated-nations.csv at build time
let unratedNations: UnratedNation[] = [];
try {
  const csvPath = path.resolve(process.cwd(), '../data/unrated-nations.csv');
  const fallbackPath = path.resolve(process.cwd(), 'public/downloads/hsri-unrated-nations.csv');
  const targetPath = fs.existsSync(csvPath) ? csvPath : fallbackPath;

  if (fs.existsSync(targetPath)) {
    const rawContent = fs.readFileSync(targetPath, 'utf-8');
    const lines = rawContent.trim().split('\n').filter(l => l.trim().length > 0);
    // skip header
    for (let i = 1; i < lines.length; i++) {
      // parse CSV line with simple quote handling
      const row = lines[i];
      const match = row.match(/(?:^|,)("(?:[^"]|"")*"|[^,]*)/g);
      if (match) {
        const cols = match.map(c => {
          let val = c.startsWith(',') ? c.slice(1) : c;
          val = val.trim();
          if (val.startsWith('"') && val.endsWith('"')) {
            val = val.slice(1, -1).replace(/""/g, '"');
          }
          return val;
        });

        if (cols.length >= 8) {
          unratedNations.push({
            country_iso3: cols[0],
            country_name: cols[1],
            region: cols[2],
            un_subregion: cols[3],
            available_pillars: parseInt(cols[4], 10) || 0,
            missing_pillars: cols[5],
            primary_data_gap: cols[6],
            partial_coverage_notes: cols[7],
          });
        }
      }
    }
  }
} catch (e) {
  console.error("Error reading unrated nations CSV:", e);
}

// Calculate regional counts
const regionCounts: Record<string, number> = {};
for (const n of unratedNations) {
  regionCounts[n.region] = (regionCounts[n.region] || 0) + 1;
}
---

<HSRILayout title="Geographic Coverage Audit & Unrated Nations - HSRI Benchmark (v0.2)">
  <div class="coverage-page">
    <HSRIHeader client:load />

    <!-- Page Header Hero -->
    <div class="page-header">
      <div class="container">
        <div class="version-tag">HSRI v0.2 Epistemic Governance</div>
        <h1>Global Geographic Coverage &amp; Scope Audit</h1>
        <p class="subtitle">
          Transparent accounting of rated nations, evaluated unrated nations, and international microdata gaps across 195 sovereign states.
        </p>
      </div>
    </div>

    <main class="container main-content">
      <!-- Disclaimer Banner -->
      <div class="preview-notice-banner">
        <div class="notice-inner">
          <span class="notice-pill">Benchmark Scope Protocol</span>
          <p class="notice-text">
            <strong>Rule R6 Compliance:</strong> HSRI strictly refuses to impute structural NaNs or extrapolate scores to nations lacking empirical microdata. 39 nations are currently benchmarked, 86 evaluated nations remain unrated due to indicator sparsity, and 70 nations have zero international telemetry.
          </p>
        </div>
      </div>

      <!-- Scope Breakdown Cards -->
      <section class="metrics-grid">
        <div class="metric-card card-rated">
          <div class="metric-icon">✓</div>
          <div class="metric-num">39</div>
          <div class="metric-label">Benchmark Rated Nations</div>
          <div class="metric-desc">High-income &amp; OECD cohort with &ge; 60% empirical indicator coverage across all 4 pillars.</div>
        </div>

        <div class="metric-card card-unrated">
          <div class="metric-icon">⚠</div>
          <div class="metric-num">86</div>
          <div class="metric-label">Evaluated Unrated Nations</div>
          <div class="metric-desc">Partial governance or connectivity data observed, but lacking verified cognitive microdata.</div>
        </div>

        <div class="metric-card card-scope">
          <div class="metric-icon">📊</div>
          <div class="metric-num">125</div>
          <div class="metric-label">Total Nations in Audit Scope</div>
          <div class="metric-desc">Formally tracked across international source indices (World Bank, ITU, OECD, V-Dem).</div>
        </div>

        <div class="metric-card card-unmonitored">
          <div class="metric-icon">✕</div>
          <div class="metric-num">70</div>
          <div class="metric-label">Unmonitored Global Nations</div>
          <div class="metric-desc">Recognized UN sovereign states with zero empirical telemetry in frontier AI readiness metrics.</div>
        </div>
      </section>

      <!-- Why Coverage is Limited Section -->
      <section class="rationale-section">
        <h2>Why Coverage is Limited to 39 Nations in v0.2</h2>
        <div class="rationale-card">
          <p class="lead-text">
            The Human Superintelligence Readiness Index (HSRI) prioritizes <strong>epistemic integrity over artificial completeness</strong>. Generating headline scores for nations that lack validated empirical measurement would introduce severe automation bias, creating an illusion of precision that harms evidence-based policy.
          </p>
          <div class="rationale-columns">
            <div class="rationale-col">
              <h4>1. The 60% Pillar Completeness Rule</h4>
              <p>
                To receive a composite headline score, a nation must possess observed empirical data for at least 60% of indicators within each of the four core pillars. While 86 evaluated economies have robust institutional governance tracking (e.g., Worldwide Governance Indicators) or telecommunications data (ITU), none possess empirical adult cognitive testing microdata.
              </p>
            </div>
            <div class="rationale-col">
              <h4>2. The Structural NaN Policy</h4>
              <p>
                Non-participation in international testing programs like OECD PIAAC (Program for the International Assessment of Adult Competencies) or EU EMLI (European Media Literacy Index) is an administrative reality, not a random missing value. Imputing scores across non-participating nations would confound actual cognitive discernment with administrative affiliation.
              </p>
            </div>
            <div class="rationale-col">
              <h4>3. Required Data to Expand Coverage</h4>
              <p>
                Expanding HSRI coverage beyond 39 nations requires non-OECD statistical agencies to administer standardized digital reasoning instruments, adult problem-solving assessments in technology-rich environments, and calibrated algorithmic trust surveys.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Regional Distribution of the 86 Unrated Nations -->
      <section class="regional-section">
        <div class="section-header">
          <h2>Regional Distribution of Unrated Nations ({unratedNations.length} Total)</h2>
          <p>Distribution of audited economies currently lacking multi-pillar data by UN continental region:</p>
        </div>

        <div class="region-pills">
          {Object.entries(regionCounts).map(([reg, count]) => (
            <div class="region-pill">
              <span class="region-name">{reg}</span>
              <span class="region-count">{count} unrated</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Unrated Nations Table -->
      <section class="table-section">
        <div class="table-header-bar">
          <div>
            <h2>Comprehensive Register of Unrated Nations</h2>
            <p>Every sovereign nation evaluated in our coverage audit that does not currently receive a benchmark score:</p>
          </div>
          <div class="table-actions">
            <a href={`${base}/downloads/hsri-unrated-nations.csv`} class="btn-download" download>
              Download CSV (86 rows) &darr;
            </a>
          </div>
        </div>

        <div class="table-responsive">
          <table class="unrated-table" id="unratedTable">
            <thead>
              <tr>
                <th>ISO3</th>
                <th>Country Name</th>
                <th>Region</th>
                <th>UN Subregion</th>
                <th>Observed Pillars</th>
                <th>Primary Data Gap</th>
                <th>Diagnostic Assessment</th>
              </tr>
            </thead>
            <tbody>
              {unratedNations.map((nation) => (
                <tr>
                  <td><span class="iso-badge">{nation.country_iso3}</span></td>
                  <td><strong>{nation.country_name}</strong></td>
                  <td>{nation.region}</td>
                  <td><span class="subregion-text">{nation.un_subregion}</span></td>
                  <td>
                    <span class={`pillar-tag tag-${nation.available_pillars}`}>
                      {nation.available_pillars} / 4 Pillars
                    </span>
                  </td>
                  <td>
                    <code class="gap-code">{nation.primary_data_gap}</code>
                  </td>
                  <td class="notes-cell">{nation.partial_coverage_notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Researcher Call To Action -->
      <section class="cta-section">
        <div class="cta-card">
          <div class="cta-content">
            <h3>Are you a researcher or statistical agency with missing data?</h3>
            <p>
              We welcome microdata submissions, regional survey partnerships, and peer-reviewed cognitive telemetry for any unrated nation. All proposals are audited through our multi-model epistemic review pipeline before incorporation.
            </p>
          </div>
          <div class="cta-actions">
            <a
              href="https://github.com/krish-rm/hsri-research/issues/new?title=%5BCoverage+Expansion%5D+&labels=coverage-expansion"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              Submit Data via GitHub Issues &rarr;
            </a>
            <a href={`${base}/data/`} class="btn-secondary">
              Explore Open Data Catalog &rarr;
            </a>
          </div>
        </div>
      </section>
    </main>

    <HSRIFooter />
  </div>
</HSRILayout>

<style>
  .coverage-page {
    min-height: 100vh;
    background-color: var(--surface-color, #f8fafc);
  }

  .page-header {
    text-align: center;
    padding: 3rem 1.5rem 2.5rem;
