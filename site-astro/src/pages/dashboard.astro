---
import HSRILayout from '../layouts/HSRILayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import TakeoffDilemmas from '../components/TakeoffDilemmas.svelte';
import FeaturedScenariosDeck from '../components/FeaturedScenariosDeck.svelte';
import SovereignCountryRadar from '../components/SovereignCountryRadar.svelte';

import countryScoresRaw from '../data/country_scores.json';

const meta = countryScoresRaw.metadata || {};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<HSRILayout title="Human Superintelligence Readiness Index (HSRI) 2.0 — The Civilizational Sentinel">
  <div class="home-page">
    <HSRIHeader client:load currentPath={Astro.url.pathname} />

    <!-- HERO SECTION -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-center">
          <div class="eyebrow-sentinel">
            <span class="pulse-dot"></span>
            THE CIVILIZATIONAL SENTINEL FOR THE SUPERINTELLIGENCE ERA
          </div>

          <h1 class="hero-h1">
            When Superintelligence Takes Off,<br />
            <span class="gradient-text">What Happens to Human Sovereignty?</span>
          </h1>

          <p class="hero-subhead">
            Measuring whether human societies can maintain oversight, survive machine-speed attacks, 
            and endure if the digital cloud goes dark.
          </p>

          <!-- Precursor Telemetry Ribbon (3 Real-Time Indicators) -->
          <div class="telemetry-ribbon">
            <div class="ribbon-card">
              <div class="ribbon-metric">3,200x</div>
              <div class="ribbon-label">Verification Latency Wedge</div>
              <div class="ribbon-desc">Machine code generation vs. human audit time</div>
            </div>
            <div class="ribbon-card">
              <div class="ribbon-metric">63.6%</div>
              <div class="ribbon-label">Machine Autonomy Share</div>
              <div class="ribbon-desc">M2M economic &amp; logistical volume</div>
            </div>
            <div class="ribbon-card highlight-card">
              <div class="ribbon-metric">48 Hours</div>
              <div class="ribbon-label">Decoupling Half-Life (T_half)</div>
              <div class="ribbon-desc">Median survival floor during cloud blackout</div>
            </div>
          </div>

          <!-- Primary CTAs -->
          <div class="hero-cta-row">
            <a href="#scenarios" class="btn btn-primary btn-large">
              Explore 26 Takeoff Scenarios &darr;
            </a>
            <a href={`${base}/seismograph/`} class="btn btn-secondary btn-large">
              Live Precursor Seismograph (8.44/10) &rarr;
            </a>
            <a href={`${base}/research/decoupling-drill/`} class="btn btn-outline btn-large">
              Run Tabletop Decoupling Drill
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: THE FIVE EXISTENTIAL DILEMMAS -->
    <section class="section-wrapper light-bg">
      <div class="container">
        <TakeoffDilemmas client:load />
      </div>
    </section>

    <!-- SECTION 3: THE 26 TAKEOFF SCENARIOS DECK -->
    <section class="section-wrapper">
      <div class="container">
        <FeaturedScenariosDeck client:load />
      </div>
    </section>

    <!-- SECTION 4: FULL-WIDTH PRECURSOR SEISMOGRAPH SENTINEL BANNER -->
    <section class="seismograph-banner-section">
      <div class="container">
        <div class="seismograph-banner-box">
          <div class="banner-badge-row">
            <span class="threat-score-pill">MASTER PRECURSOR THREAT: 8.44 / 10.0</span>
            <span class="status-pill red-pulse">CRITICAL SUPERVISORY COLLAPSE</span>
          </div>

          <h2 class="banner-title">Real-Time Autonomy Seismometer &amp; Latent Drift</h2>
          <p class="banner-text">
            Continuous empirical telemetry tracking the algorithmic speed gap, steganographic token drift, 
            and the CORS 10.0 Recursive Event Horizon. Distinguishing observed historical trends from projected forward stress trajectories.
          </p>

          <div class="banner-stats-row">
            <div class="b-stat">
              <span class="b-label">Wedge Accelerometer</span>
              <span class="b-val">CORS 10.0</span>
              <span class="b-sub">&Delta;T = 4,798.5s</span>
            </div>
            <div class="b-stat">
              <span class="b-label">M2M Autonomy Index</span>
              <span class="b-val">8.78 / 10</span>
              <span class="b-sub">HPTG = 75.6%</span>
            </div>
            <div class="b-stat">
              <span class="b-label">Latent Drift Confidence</span>
              <span class="b-val">98.0%</span>
              <span class="b-sub">HPI = 30.6%</span>
            </div>
          </div>

          <div class="banner-cta">
            <a href={`${base}/seismograph/`} class="btn btn-banner">
              Open Full Live Seismograph Dashboard &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: TWO-COLUMN INSTITUTIONAL PRODUCTS SPLIT -->
    <section class="section-wrapper products-split-section">
      <div class="container">
        <div class="products-grid">
          <!-- Left: Tabletop Decoupling Drill -->
          <div class="product-box">
            <div class="p-eyebrow">NATIONAL SECURITY &amp; EMERGENCY PLANNING</div>
            <h3 class="p-title">Tabletop Decoupling Drill</h3>
            <p class="p-desc">
              An interactive 4-round crisis facilitator console for national security councils, hospital networks, 
              and energy operators to simulate surviving a 14-day digital cloud blackout. Live Leontief floor calculation and 1-click After-Action Report (AAR) export.
            </p>
            <div class="p-features">
              <span>&check; 4 Host Presets (RSIS, ETH Zurich, MBZUAI, US Fed)</span>
              <span>&check; 8 Crisis Inject Cards</span>
              <span>&check; 45-Min Facilitator Clock</span>
            </div>
            <a href={`${base}/research/decoupling-drill/`} class="btn btn-product">
              Launch Facilitator Console &rarr;
            </a>
          </div>

          <!-- Right: Sovereign Reinsurance Calculator -->
          <div class="product-box">
            <div class="p-eyebrow">CAPITAL MARKETS &amp; ACTUARIAL PRICING</div>
            <h3 class="p-title">Sovereign Reinsurance Facility</h3>
            <p class="p-desc">
              Solvency II 99.5% capital charge pricing for civilizational decoupling risk. 
              Computes Expected Decoupling Loss (ECDL) and outputs standard Lloyd's Syndicate Placement Slips (Market Clause L2-DEC-01) for catastrophic risk underwriters.
            </p>
            <div class="p-features">
              <span>&check; Solvency II 99.5% SCR Capital Charge</span>
              <span>&check; &Phi; Loading Factor (0.35x &ndash; 2.096x)</span>
              <span>&check; Lloyd's Syndicate Slip Markdown Download</span>
            </div>
            <a href={`${base}/reinsurance/`} class="btn btn-product">
              Open Actuarial Calculator &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6: SOVEREIGN COUNTRY RADAR -->
    <section class="section-wrapper light-bg">
      <div class="container">
        <SovereignCountryRadar client:load />
      </div>
    </section>

    <!-- SECTION 7: PROOF BAR & INSTITUTIONAL BEDROCK -->
    <section class="proof-bar-section">
      <div class="container">
        <div class="proof-bar-inner">
          <div class="proof-item">
            <span class="proof-val">261 Tests</span>
            <span class="proof-desc">100% CI Green Passing</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-item">
            <span class="proof-val">Permanent DOI</span>
            <span class="proof-desc">10.5281/zenodo.23441742</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-item">
            <span class="proof-val">Open Science</span>
            <span class="proof-desc">CC BY-SA 4.0 Verified</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-item">
            <span class="proof-val">Institutional Grounding</span>
            <span class="proof-desc">HSRI Research Consortium</span>
          </div>
        </div>
      </div>
    </section>

    <HSRIFooter client:load />
  </div>
</HSRILayout>

<style>
  .home-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-family: var(--font-family-sans);
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .section-wrapper {
    padding: 3rem 0;
  }

  .light-bg {
    background-color: var(--bg-surface-sunken);
  }

  /* HERO SECTION */
  .hero-section {
    padding: 5rem 0 3.5rem 0;
    background: radial-gradient(circle at 50% 15%, var(--accent-primary-glow) 0%, var(--bg-canvas) 70%);
    border-bottom: 1px solid var(--border-subtle);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-center {
    max-width: 920px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .eyebrow-sentinel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    background: var(--threat-telemetry-bg);
    border: 1px solid var(--threat-telemetry-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--threat-critical);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  .hero-h1 {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem 0;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent-primary) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subhead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0 auto 2.5rem auto;
    max-width: 740px;
  }

  /* Telemetry Ribbon */
  .telemetry-ribbon {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .ribbon-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.25rem 1rem;
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .ribbon-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-medium);
  }

  .highlight-card {
    border-color: var(--accent-primary);
    background: var(--bg-surface-elevated);
    box-shadow: 0 0 15px -3px var(--accent-primary-glow);
  }

  .ribbon-metric {
    font-family: var(--font-family-mono);
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .ribbon-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
    letter-spacing: 0.04em;
  }

  .ribbon-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Hero CTA Row */
  .hero-cta-row {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-large {
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: #ffffff;
    border: 1px solid var(--accent-primary);
  }

  .btn-primary:hover {
    background: var(--accent-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--accent-primary-glow);
  }

  .btn-secondary {
    background: var(--bg-surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }

  .btn-secondary:hover {
    background: var(--bg-surface-sunken);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }

  .btn-outline:hover {
    background: var(--bg-surface-elevated);
    border-color: var(--accent-primary);
  }

  /* SEISMOGRAPH BANNER */
  .seismograph-banner-section {
    padding: 3.5rem 0;
    background: var(--bg-surface-sunken);
    color: var(--text-primary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .seismograph-banner-box {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .banner-badge-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .threat-score-pill {
    font-family: var(--font-family-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--threat-critical);
    background: var(--threat-critical-bg);
    border: 1px solid var(--threat-critical-border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .status-pill {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--threat-warning);
    background: var(--threat-warning-bg);
    border: 1px solid var(--threat-warning-border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }

  .banner-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .banner-text {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 2rem 0;
  }

  .banner-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .b-stat {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .b-label {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .b-val {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent-primary);
    font-variant-numeric: tabular-nums;
  }

  .b-sub {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .btn-banner {
    background: var(--accent-primary);
    color: #ffffff;
    font-weight: 700;
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    display: inline-block;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .btn-banner:hover {
    background: var(--accent-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px var(--accent-primary-glow);
  }

  /* PRODUCTS SPLIT */
  .products-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .product-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .product-box:hover {
    border-color: var(--border-medium);
    transform: translateY(-2px);
  }

  .p-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.70rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    margin-bottom: 0.5rem;
  }

  .p-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.85rem 0;
  }

  .p-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  .p-features {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .btn-product {
    background: var(--accent-primary);
    color: #ffffff;
    padding: 0.8rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    transition: background 0.2s ease;
  }

  .btn-product:hover {
    background: var(--accent-primary-hover);
  }

  /* PROOF BAR */
  .proof-bar-section {
    padding: 2.25rem 0;
    background: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .proof-bar-inner {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    text-align: center;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .proof-val {
    font-family: var(--font-family-mono);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .proof-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .proof-divider {
    width: 1px;
    height: 36px;
    background: var(--border-subtle);
  }

  @media (max-width: 860px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .telemetry-ribbon {
      grid-template-columns: 1fr;
    }
    .banner-stats-row {
      grid-template-columns: 1fr;
    }
    .hero-h1 {
      font-size: 2.25rem;
    }
    .proof-divider {
      display: none;
    }
  }
</style>