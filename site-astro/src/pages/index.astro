---
// index.astro — "Humanity Readiness: are we ready to receive what we're wishing for?"
// Phase 1 Story-First Entry Page: static Astro HTML + minimal Svelte interactive islands.
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HeroStory from '../components/HeroStory.svelte';
import FiveDoorsPreview from '../components/FiveDoorsPreview.svelte';
import CountryCatchWidget from '../components/CountryCatchWidget.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import precursorSummary from '../data/precursor_summary.json';
import { buildCountryWidgetCatalog } from '../lib/countryData';
import { en } from '../i18n/en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Section 2: Deterministic Pulse state from live precursor_summary.json (Decision #1)
// 0.0-3.9 Steady | 4.0-6.9 Stirring | 7.0-10.0 Rising
const rawPulseScore = Number(precursorSummary.master_precursor_threat_score ?? 8.44);
const pulseKey: 'steady' | 'stirring' | 'rising' =
  rawPulseScore < 4.0 ? 'steady' : rawPulseScore < 7.0 ? 'stirring' : 'rising';
const activePulse = en.pulse.states[pulseKey];

// Section 6: Pass ONLY compact 8-country initial starter subset into SSR island HTML;
// Full 148-country catalog lazy-loads when CountryCatchWidget hydrates on viewport.
const starterIsos = new Set(['NOR', 'DEU', 'JPN', 'USA', 'SGP', 'BRA', 'IND', 'NGA']);
const countryCatalog = buildCountryWidgetCatalog().filter((c) => starterIsos.has(c.iso));
---

<BaseLayout title={en.meta.title} description={en.meta.description}>
  <HSRIHeader client:interact currentPath={Astro.url.pathname} />

  <main class="story-canvas">
    <!-- =================================================================== -->
    <!-- SECTION 1: HERO (Global Harbour, Kalpa Arrival, Empty Crowd Ring)   -->
    <!-- =================================================================== -->
    <HeroStory client:interact />
    <script is:inline>try{let i={Lagos:1,Sao_Paulo:2,Kolkata:3,Calcutta:3,Berlin:4,Jakarta:5,Dubai:6,Toronto:7,Nairobi:8}[Intl.DateTimeFormat().resolvedOptions().timeZone.split("/").pop()],p=document.querySelectorAll(".city-pill"),b=i&&p[i];if(b){let d=b.dataset.c.split("|");window.__hc=b.dataset.city;hcn.textContent=b.textContent;hcr.textContent=d[0];[hst,hsb,hsa].map((e,j)=>e.setAttribute("stop-color",d[j+1]));p[0].classList.remove("active");b.classList.add("active")}}catch{}</script>

    <!-- =================================================================== -->
    <!-- SECTION 2: HUMANITY'S PULSE (Calm Thin Strip, Real Live Score)      -->
    <!-- =================================================================== -->
    <section id="pulse" class="pulse-strip" aria-label={en.pulse.label}>
      <div class="story-container">
        <div class="pulse-inner">
          <div class="pulse-status-cluster">
            <span class="pulse-name">{en.pulse.label}</span>
            <span class={`pulse-pill state-${pulseKey}`}>{activePulse.word}</span>
          </div>

          <p class="pulse-sentence">{activePulse.sentence}</p>

          <div class="pulse-actions">
            <details class="pulse-tooltip">
              <summary class="pulse-tip-summary">
                <span aria-hidden="true">ⓘ</span> {en.pulse.tooltipTrigger}
              </summary>
              <div class="pulse-tip-card">
                Technical reading: <strong>{rawPulseScore.toFixed(2)} / 10</strong> on the live system-speed and oversight monitor (checked periodically from open benchmarks).
              </div>
            </details>

            <a href={`${base}/seismograph/`} class="pulse-link">
              {en.pulse.cta} <span class="arrow-flip" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTIONS 3, 4 & 5: FIVE DOORS, FOUR MOMENTS & FIVE LIGHTS           -->
    <!-- =================================================================== -->
    <div class="defer-island">
      <FiveDoorsPreview client:visible />
    </div>

    <!-- =================================================================== -->
    <!-- SECTION 6: CAN YOUR COUNTRY CATCH THE GIFT? (39 Rated + All Unrated) -->
    <!-- =================================================================== -->
    <div class="defer-island">
      <CountryCatchWidget client:visible countries={countryCatalog} base={base} />
    </div>

    <!-- =================================================================== -->
    <!-- SECTION 7: THIS WEEK IN KALPA'S CITY (Pilot Episode 1 Preview)      -->
    <!-- =================================================================== -->
    <section id="this-week" class="story-block defer-section">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title">{en.episode.heading}</h2>
        </div>

        <div class="episode-grid">
          <article class="episode-card">
            <div class="ep-top">
              <span class="ep-badge">{en.episode.badge}</span>
            </div>
            <h3 class="ep-title">Episode 1: &ldquo;{en.episode.title}&rdquo;</h3>
            <p class="ep-body">{en.episode.synopsis}</p>
            <div class="ep-real-life">
              <span class="rl-tag">REAL LIFE ACTION</span>
              <p>Keep one small paper note of essential family contacts and prescriptions offline so calm care continues even if digital tools hiccup.</p>
            </div>
            <p class="ep-note">{en.episode.voteNote}</p>
          </article>

          <aside class="recap-card">
            <h3 class="recap-title">{en.episode.recapTitle}</h3>
            <p class="recap-body">{en.episode.recapBody}</p>
            <p class="recap-status">{en.episode.recapStatus}</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 8: THE WISH WALL (Honest Invitation State Until n >= 20)    -->
    <!-- =================================================================== -->
    <section id="wish-wall" class="story-block alt-surface defer-section">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title">{en.wishWall.heading}</h2>
        </div>

        <div class="wall-invitation-box">
          <div class="wall-themes" aria-label="Wish themes">
            {en.wishWall.themes.map((theme) => (
              <span class="theme-tag">{theme}</span>
            ))}
          </div>
          <h3 class="wall-empty-head">{en.wishWall.emptyHeadline}</h3>
          <p class="wall-empty-body">{en.wishWall.emptyBody}</p>
          <a href="#wish-doors" class="btn-wall-cta">
            {en.wishWall.cta} <span class="arrow-flip" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 9: WHY A GOOD WISH STILL NEEDS A GOOD WISHER                -->
    <!-- =================================================================== -->
    <section id="why-good-wisher" class="story-block defer-section">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title">{en.wisher.heading}</h2>
        </div>

        <div class="wisher-dual-grid">
          {en.wisher.cards.map((card) => (
            <article class="wisher-card">
              <h3 class="wisher-title">{card.title}</h3>
              <p class="wisher-body">{card.body}</p>
              <details class="card-tech-note">
                <summary>ⓘ Technical reading</summary>
                <p>{card.techHint}</p>
              </details>
            </article>
          ))}
        </div>

        <p class="wisher-closing">{en.wisher.closingLine}</p>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 10: GO DEEPER ("The research behind the story")             -->
    <!-- =================================================================== -->
    <section id="go-deeper" class="story-block alt-surface">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title">{en.deeper.heading}</h2>
          <p class="sec-sub">{en.deeper.subhead}</p>
        </div>

        <div class="deeper-grid">
          {en.deeper.cards.map((card) => (
            <article class="deeper-card">
              <span class="dc-tag">{card.tag}</span>
              <h3 class="dc-title">{card.title}</h3>
              <p class="dc-desc">{card.desc}</p>

              {'extraLinks' in card && card.extraLinks ? (
                <div class="dc-multi-links">
                  {card.extraLinks.map((sub) => (
                    <a href={`${base}${sub.href}`} class="dc-link-inline">{sub.label} &rarr;</a>
                  ))}
                </div>
              ) : (
                <a href={`${base}${card.href}`} class="dc-link">
                  Open {card.title} <span class="arrow-flip" aria-hidden="true">&rarr;</span>
                </a>
              )}
            </article>
          ))}
        </div>

        <div class="release-footer-box">
          <p class="release-note">{en.deeper.releaseNote}</p>
          <p class="release-doi">
            Permanent academic archive:
            <a href="https://doi.org/10.5281/zenodo.23441742" target="_blank" rel="noopener noreferrer">
              DOI 10.5281/zenodo.23441742
            </a>
            &middot; Open Access (CC BY-SA 4.0)
          </p>
        </div>
      </div>
    </section>
  </main>

  <HSRIFooter client:visible />
</BaseLayout>

<style>
  .story-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  .story-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.15rem;
    box-sizing: border-box;
  }

  .story-block {
    contain: layout style;
    padding: clamp(2.25rem, 4.5vw, 3.75rem) 0;
    scroll-margin-top: 112px;
  }

  .defer-island {
    content-visibility: auto;
    contain-intrinsic-size: auto 720px;
  }

  .defer-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 480px;
  }

  .alt-surface {
    background: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .sec-title {
    font-family: var(--font-family-sans);
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.55rem;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .sec-sub {
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  :global([dir='rtl']) .arrow-flip {
    display: inline-block;
    transform: scaleX(-1);
  }

  /* Section 2: Humanity's Pulse */
  .pulse-strip {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
    padding: 0.95rem 0;
  }

  .pulse-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }

  .pulse-status-cluster {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .pulse-name {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .pulse-pill {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
  }

  .pulse-pill.state-steady {
    background: var(--threat-sovereign-bg);
    color: var(--threat-sovereign);
    border: 1px solid var(--threat-sovereign-border);
  }

  .pulse-pill.state-stirring,
  .pulse-pill.state-rising {
    background: var(--threat-warning-bg);
    color: var(--threat-warning);
    border: 1px solid var(--threat-warning-border);
  }

  .pulse-sentence {
    margin: 0;
    flex: 1 1 320px;
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .pulse-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    position: relative;
  }

  .pulse-tooltip {
    position: relative;
  }

  .pulse-tip-summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
  }

  .pulse-tip-summary::-webkit-details-marker {
    display: none;
  }

  .pulse-tip-card {
    margin-top: 0.45rem;
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    font-size: 0.8rem;
    color: var(--text-secondary);
    max-width: 300px;
    box-shadow: var(--shadow-sm);
  }

  .pulse-link {
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--accent-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .pulse-link:hover {
    text-decoration: underline;
  }

  /* Section 7: Pilot Episode Teaser */
  .episode-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.15rem;
  }

  .episode-card,
  .recap-card {
    contain: layout style;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.35rem;
  }

  .ep-badge {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--threat-sovereign-bg);
    color: var(--threat-sovereign);
    margin-bottom: 0.55rem;
  }

  .ep-title,
  .recap-title {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.22rem;
    margin: 0 0 0.55rem;
    color: var(--text-primary);
  }

  .ep-body,
  .recap-body {
    margin: 0 0 0.9rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .ep-real-life {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--accent-primary);
    border-radius: 10px;
    padding: 0.8rem 0.95rem;
    margin-bottom: 0.85rem;
  }

  .rl-tag {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--accent-primary);
    margin-bottom: 0.2rem;
  }

  .ep-real-life p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .ep-note,
  .recap-status {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Section 8: Wish Wall */
  .wall-invitation-box {
    max-width: 780px;
    margin: 0 auto;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 1.75rem 1.35rem;
    text-align: center;
  }

  .wall-themes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.15rem;
  }

  .theme-tag {
    font-family: var(--font-family-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .wall-empty-head {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.18rem;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }

  .wall-empty-body {
    margin: 0 auto 1.2rem;
    max-width: 580px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .btn-wall-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.35rem;
    border-radius: 10px;
    background: var(--accent-primary);
    color: var(--btn-primary-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .btn-wall-cta:hover {
    background: var(--accent-primary-hover);
  }

  /* Section 9: Why a good wish needs a good wisher */
  .wisher-dual-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.15rem;
    margin-bottom: 1.45rem;
  }

  .wisher-card {
    contain: layout style;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.35rem;
  }

  .wisher-title {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.22rem;
    margin: 0 0 0.55rem;
    color: var(--accent-primary);
  }

  .wisher-body {
    margin: 0 0 0.75rem;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--text-primary);
  }

  .card-tech-note summary {
    cursor: pointer;
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .card-tech-note p {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .wisher-closing {
    text-align: center;
    font-family: var(--font-family-sans);
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  /* Section 10: Go Deeper */
  .deeper-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .deeper-card {
    contain: layout style;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .dc-tag {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-primary);
    margin-bottom: 0.4rem;
  }

  .dc-title {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 0 0 0.45rem;
    color: var(--text-primary);
  }

  .dc-desc {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    line-height: 1.52;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .dc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    padding: 0.5rem 0.95rem;
    border-radius: 8px;
    background: var(--accent-primary);
    color: var(--btn-primary-text);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .dc-link:hover {
    background: var(--accent-primary-hover);
  }

  .dc-multi-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
  }

  .dc-link-inline {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--accent-primary);
    text-decoration: none;
  }

  .dc-link-inline:hover {
    text-decoration: underline;
  }

  .release-footer-box {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    text-align: center;
  }

  .release-note {
    margin: 0 0 0.35rem;
    font-size: 0.86rem;
    color: var(--text-secondary);
  }

  .release-doi {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .release-doi a {
    color: var(--accent-primary);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .deeper-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .episode-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .wisher-dual-grid,
    .deeper-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
