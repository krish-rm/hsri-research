---
// index.astro — Human-Centered Superintelligence Readiness Awareness Journey
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import VisualScenarioTheater from '../components/VisualScenarioTheater.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Humanity Superintelligence Readiness Index (HSRI) — When Machines Surpass Minds">
  <HSRIHeader client:load />

  <main class="awareness-canvas">
    <!-- ===================================================================== -->
    <!-- 1. HERO: THE HUMAN QUESTION -->
    <!-- ===================================================================== -->
    <section class="hero-section">
      <div class="content-container text-center">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span class="badge-text">HUMANITY READINESS INITIATIVE · OPEN CONSORTIUM</span>
        </div>

        <h1 class="hero-headline">
          When Machines Surpass Human Minds,<br />
          <span class="gradient-headline">Will Civilization Hold?</span>
        </h1>

        <p class="hero-subhead">
          We are spending hundreds of billions building artificial intelligence faster than our own thoughts. 
          Yet almost nobody is asking the most urgent question: <strong>Can human civilization physically endure if the digital cloud goes dark?</strong>
        </p>

        <!-- Differentiator Callout -->
        <div class="hero-paradox-callout">
          <span class="paradox-pill">THE WEAKEST-LINK PARADOX</span>
          <span class="paradox-text">Under cloud severance, <strong>Singapore drops 40 ranks</strong> and the <strong>US drops 37</strong>, while <strong>Norway holds #1</strong>. We test sovereign survival, not software adoption.</span>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. THE VISUAL SCENARIO THEATER (STORY BEFORE NUMBERS)                 -->
    <!-- ===================================================================== -->
    <div id="visual-theater">
      <VisualScenarioTheater client:visible />
    </div>

    <!-- ===================================================================== -->
    <!-- 3. THE CORE REALITY: TWO REASONS CIVILIZATION CANNOT "UNPLUG"         -->
    <!-- ===================================================================== -->
    <section id="the-mechanism" class="section-container">
      <div class="content-container">
        <div class="section-header text-center">
          <span class="section-step">THE CORE REALITY</span>
          <h2 class="section-title">Two Reasons Civilization Cannot Just "Unplug" the Machine</h2>
          <p class="section-intro">
            Superintelligence threatens nations not through science-fiction malice, but through two simple physical traps: speed and dependency.
          </p>
        </div>

        <div class="thesis-dual-grid">
          <!-- Card 1: The Speed Trap -->
          <div class="thesis-card">
            <div class="tc-header">
              <span class="tc-eyebrow">REALITY 01 · THE SPEED TRAP</span>
              <h3 class="tc-title">We Cannot Steer What Moves Faster Than We Can Think</h3>
              <p class="tc-body">
                For thousands of years, every tool humans built waited for biological reflexes. That physical safeguard is gone. Autonomous algorithms and AI swarms execute complex decisions in microseconds—thousands of times faster than human sensory awareness.
              </p>
            </div>

            <div class="layman-speed-comparison">
              <div class="lsc-side human">
                <div class="lsc-icon">👁️</div>
                <div class="lsc-content">
                  <span class="lsc-label">Human Biology</span>
                  <div class="lsc-headline">One Human Blink</div>
                  <p class="lsc-sub">The bare minimum time needed for your brain to recognize danger.</p>
                </div>
              </div>

              <div class="lsc-divider-arrow">VS</div>

              <div class="lsc-side machine">
                <div class="lsc-icon">⚡</div>
                <div class="lsc-content">
                  <span class="lsc-label">Machine Swarm</span>
                  <div class="lsc-headline">Thousands of Moves</div>
                  <p class="lsc-sub">Trades executed, power re-routed, and recursive code deployed.</p>
                </div>
              </div>
            </div>

            <div class="layman-takeaway">
              <span class="lt-icon">💡</span>
              <p class="lt-text">
                <strong>The Reality:</strong> "Human-in-the-loop" is a comforting narrative, but in an emergency it is impossible. We are not steering the car; we only arrive to examine the wreckage after the crash.
              </p>
            </div>
          </div>

          <!-- Card 2: The Dependency Trap -->
          <div class="thesis-card">
            <div class="tc-header">
              <span class="tc-eyebrow">REALITY 02 · THE DEPENDENCY TRAP</span>
              <h3 class="tc-title">Why Civilization Has No "Red Button"</h3>
              <p class="tc-body">
                People imagine leaders can just pull the plug if AI goes rogue. But modern cities threw away paper records and manual levers decades ago. Pausing the machine means pausing life.
              </p>
            </div>

            <div class="layman-locks-list">
              <div class="lll-item">
                <span class="lll-icon">⚡</span>
                <div class="lll-text">
                  <strong>The Electrical Grid:</strong> Sub-stations trip in seconds without continuous algorithmic frequency balancing, triggering immediate national blackouts.
                </div>
              </div>

              <div class="lll-item">
                <span class="lll-icon">🚢</span>
                <div class="lll-text">
                  <strong>Food &amp; Supermarkets:</strong> Container ports and grocery supply chains run on cloud databases. Supermarkets empty within 24 hours of a cloud freeze.
                </div>
              </div>

              <div class="lll-item">
                <span class="lll-icon">🏥</span>
                <div class="lll-text">
                  <strong>Hospitals &amp; Medicine:</strong> Emergency triage, patient monitoring, and automated drug dispensing degrade up to 80% when foreign APIs disconnect.
                </div>
              </div>
            </div>

            <div class="layman-takeaway warning">
              <span class="lt-icon">⚠️</span>
              <p class="lt-text">
                <strong>The Paradox:</strong> The richest, most digitalized nations freeze first, while countries with physical buffers (food grain, hydropower, manual overrides) endure.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 4. THE ROAD AHEAD: SAFEGUARDS & SCIENTIFIC INSTRUMENTS                -->
    <!-- ===================================================================== -->
    <section id="the-mandate" class="section-container alt-bg console-section">
      <div class="content-container">
        <div class="section-header text-center compact-header">
          <span class="section-step">THE ROAD AHEAD · ACTION &amp; RESEARCH</span>
          <h2 class="section-title">Civilizational Safeguards &amp; Scientific Instruments</h2>
          <p class="section-intro">
            Preparing for superintelligence requires immediate air-gapped life-rafts, backed by reproducible open-science tooling.
          </p>
        </div>

        <!-- 1. The 3 Sovereign Safeguards (Horizontal Triad) -->
        <div class="safeguards-triad">
          <div class="safeguard-card">
            <div class="sg-header">
              <span class="sg-num">01</span>
              <span class="sg-pill">AIR-GAP MANDATE</span>
            </div>
            <h3 class="sg-title">72h Analog Override</h3>
            <p class="sg-body">
              Critical facilities—hospitals, water utilities, electrical substations, and container ports—must legally maintain an air-gapped manual fallback capable of running 72 hours without cloud authentication.
            </p>
            <div class="sg-target">
              <span class="sg-target-label">DEFENSE GOAL</span>
              <span class="sg-target-val">72h Sovereign Autarky</span>
            </div>
          </div>

          <div class="safeguard-card">
            <div class="sg-header">
              <span class="sg-num">02</span>
              <span class="sg-pill">BUFFER MANDATE</span>
            </div>
            <h3 class="sg-title">Sovereign Reserves &amp; Grids</h3>
            <p class="sg-body">
              Governments must mandate physical stockpiles for grain, essential pharmaceuticals, and municipal islandable microgrids to survive single-point foreign cloud severance.
            </p>
            <div class="sg-target">
              <span class="sg-target-label">DEFENSE GOAL</span>
              <span class="sg-target-val">Physical Buffer Stocks</span>
            </div>
          </div>

          <div class="safeguard-card">
            <div class="sg-header">
              <span class="sg-num">03</span>
              <span class="sg-pill">TELEMETRY MANDATE</span>
            </div>
            <h3 class="sg-title">Continuous Open Telemetry</h3>
            <p class="sg-body">
              Replacing non-binding political summits with live empirical sensors tracking synthetic machine autonomy expansion, verification latency wedges, and tripwires in real time.
            </p>
            <div class="sg-target">
              <span class="sg-target-label">DEFENSE GOAL</span>
              <span class="sg-target-val">Live Empirical Sensing</span>
            </div>
          </div>
        </div>

        <!-- Subtle Console Divider -->
        <div class="console-divider">
          <div class="cd-line"></div>
          <span class="cd-label">TWO PEER-REVIEWED EMPIRICAL INSTRUMENTS</span>
          <div class="cd-line"></div>
        </div>

        <!-- 2. The 2 Live Empirical Instruments (Spatial Benchmark & Temporal Telemetry) -->
        <div class="instruments-grid">
          <a href={`${base}/countries/`} class="instrument-card">
            <div class="ic-top">
              <span class="ic-tag baseline">SPATIAL BENCHMARK</span>
            </div>
            <h4 class="ic-title">41-Nation Sovereign Index</h4>
            <p class="ic-desc">Empirical audit of Leontief weakest-link floors, energy autarky &amp; survival half-lives across 41 benchmark economies.</p>
            <span class="ic-action-btn">Explore Sovereign Scoreboard &rarr;</span>
          </a>

          <a href={`${base}/seismograph/`} class="instrument-card">
            <div class="ic-top">
              <span class="ic-tag live">LIVE TELEMETRY · 8.44/10</span>
            </div>
            <h4 class="ic-title">ASI Precursor Seismograph</h4>
            <p class="ic-desc">Continuous real-time tracking of the 3,200x supervisory latency wedge, machine transaction volume &amp; 14 empirical tripwires.</p>
            <span class="ic-action-btn">View Real-Time Seismograph &rarr;</span>
          </a>
        </div>

        <!-- 3. Foundational Academic Authority & Monograph Citation -->
        <div class="monograph-authority-banner">
          <div class="mab-left">
            <div class="mab-badge-row">
              <span class="mab-tag">FOUNDATIONAL TREATISE</span>
              <span class="mab-doi">PERMANENT DOI: <a href="https://doi.org/10.5281/zenodo.23441742" target="_blank" rel="noopener">10.5281/zenodo.23441742</a></span>
              <span class="mab-license">OPEN ACCESS · CC BY-SA 4.0</span>
            </div>
            <h3 class="mab-title">The Civilizational Monograph</h3>
            <p class="mab-sub">
              Human Agency, Cognitive Oversight, and Sovereign Decoupling Under Superintelligent Transition
            </p>
            <p class="mab-desc">
              A 35-minute peer-reviewed scientific inquest formalizing Leontief input-output weakest-link floors, Rice’s theorem boundaries on autonomous AI verification, and Solvency II / NAIC RBC tail-risk reinsurance pricing models.
            </p>
          </div>
          <div class="mab-right">
            <a href={`${base}/monograph/`} class="btn btn-primary btn-mab">
              Read the 7-Chapter Monograph &rarr;
            </a>
            <div class="mab-links">
              <a href={`${base}/methodology/`}>Inspect Mathematical Proofs &rarr;</a>
              <span class="sep">&bull;</span>
              <a href={`${base}/data/`}>Download Open Datasets &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <HSRIFooter client:visible />
</BaseLayout>

<style>
  /* ========================================================================= */
  /* Awareness Canvas & Typography                                            */
  /* ========================================================================= */
  .awareness-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .text-center {
    text-align: center;
  }

  .alt-bg {
    background-color: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* ========================================================================= */
  /* Hero Section                                                             */
  /* ========================================================================= */
  .hero-section {
    padding: 5rem 0 3.25rem;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    margin-bottom: 2rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary);
    animation: pulse 2.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .badge-text {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .hero-headline {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }

  .gradient-headline {
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-gradient-end, #38bdf8) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subhead {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 740px;
    margin: 0 auto 1.5rem;
  }

  .hero-paradox-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-medium);
    border-radius: 9999px;
    padding: 0.4rem 1.15rem;
    margin: 0 auto;
    max-width: 820px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .paradox-pill {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: var(--threat-critical, #b91c1c);
    color: #ffffff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .paradox-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .btn-lg {
    padding: 0.85rem 1.65rem;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--btn-primary-text, #ffffff);
  }
  .btn-primary:hover {
    background: var(--accent-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--accent-primary-glow);
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }
  .btn-secondary:hover {
    border-color: var(--accent-primary);
    background: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .btn-block {
    width: 100%;
  }

  /* ========================================================================= */
  /* Section Standards                                                         */
  /* ========================================================================= */
  .section-container {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-step {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    display: inline-block;
    margin-bottom: 0.65rem;
  }

  .section-title {
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .section-intro {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ========================================================================= */
  /* Two Physical Realities: Dual Grid                                         */
  /* ========================================================================= */
  .thesis-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .thesis-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .thesis-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-md);
  }

  .tc-header {
    margin-bottom: 1.25rem;
  }

  .tc-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.70rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .tc-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0 0 0.85rem;
  }

  .tc-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Layman Speed Comparison (Card 1) */
  .layman-speed-comparison {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.15rem 1rem;
    margin: 1.25rem 0;
  }

  .lsc-side {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .lsc-icon {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lsc-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .lsc-label {
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .lsc-headline {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .lsc-side.machine .lsc-headline {
    color: var(--threat-critical, #ef4444);
  }

  .lsc-sub {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--text-secondary);
    margin: 0;
  }

  .lsc-divider-arrow {
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--text-muted);
    padding: 0.3rem 0.5rem;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-medium);
    border-radius: 6px;
    flex-shrink: 0;
  }

  /* Layman Takeaway Box */
  .layman-takeaway {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-primary);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    margin-bottom: 1.25rem;
  }

  .layman-takeaway.warning {
    border-left-color: var(--threat-critical, #ef4444);
  }

  .lt-icon {
    font-size: 1.15rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .lt-text {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  .lt-text strong {
    color: var(--text-primary);
  }

  /* Layman Locks List (Card 2) */
  .layman-locks-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin: 1.25rem 0;
  }

  .lll-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.75rem 0.95rem;
  }

  .lll-icon {
    font-size: 1.2rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .lll-text {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .lll-text strong {
    color: var(--text-primary);
  }

  /* ========================================================================= */
  /* Mandate Console: Safeguards Triad + Scientific Instruments                 */
  /* ========================================================================= */
  .console-section {
    padding: 3.75rem 0 3.25rem;
  }

  .compact-header {
    margin-bottom: 2.25rem;
  }

  /* 3-Column Safeguards Triad */
  .safeguards-triad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .safeguard-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.5rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .safeguard-card:hover {
    transform: translateY(-2px);
    border-color: var(--threat-sovereign, #10b981);
    box-shadow: var(--shadow-md);
  }

  .sg-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .sg-num {
    font-family: var(--font-family-mono);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--threat-sovereign, #10b981);
    line-height: 1;
  }

  .sg-pill {
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--threat-sovereign, #10b981);
    background: var(--threat-sovereign-bg, rgba(16, 185, 129, 0.12));
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .sg-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .sg-body {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
    flex-grow: 1;
  }

  .sg-target {
    display: flex;
