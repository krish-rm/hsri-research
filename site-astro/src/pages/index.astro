---
// index.astro — "Humanity Readiness: are we ready for what we're asking superintelligence to deliver?"
// Phase 2.5 Story-First Entry Page: static Astro HTML + minimal Svelte interactive islands.
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HeroStory from '../components/HeroStory.svelte';
import MeetTotoCard from '../components/MeetTotoCard.svelte';
import FiveDoorsPreview from '../components/FiveDoorsPreview.svelte';
import CountryCatchWidget from '../components/CountryCatchWidget.svelte';
import GoDeeperSection from '../components/GoDeeperSection.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import precursorSummary from '../data/precursor_summary.json';
import { buildCountryWidgetCatalog } from '../lib/countryData';
import { en } from '../i18n/en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Section 2: Deterministic Pulse state from live precursor_summary.json (Decision #1)
// 0.0-3.9 Steady | 4.0-6.9 Stirring | 7.0-10.0 Rising
const rawPulseScore = Number(precursorSummary.master_precursor_threat_score ?? 8.44);
const pulseKey: 'steady' | 'stirring' | 'rising' =
  rawPulseScore < 4.0 ? 'steady' : rawPulseScore < 7.0 ? 'stirring' : 'rising';
const activePulse = en.pulse.states[pulseKey];

// Section 6: Pass ONLY compact 8-country initial starter subset into SSR island HTML;
// Full 148-country catalog lazy-loads when CountryCatchWidget hydrates on viewport.
const starterIsos = new Set(['NOR', 'DEU', 'JPN', 'USA', 'SGP', 'BRA', 'IND', 'NGA']);
const countryCatalog = buildCountryWidgetCatalog().filter((c) => starterIsos.has(c.iso));
---

<BaseLayout title={en.meta.title} description={en.meta.description}>
  <HSRIHeader client:interact currentPath={Astro.url.pathname} />

  <main class="story-canvas">
    <!-- =================================================================== -->
    <!-- SECTION 1: HERO (Global Harbour, Toto Arrival, Empty Crowd Ring)    -->
    <!-- =================================================================== -->
    <HeroStory client:interact />
    <script is:inline>try{let i={Lagos:1,Sao_Paulo:2,Kolkata:3,Calcutta:3,Berlin:4,Jakarta:5,Dubai:6,Toronto:7,Nairobi:8}[Intl.DateTimeFormat().resolvedOptions().timeZone.split("/").pop()],p=document.querySelectorAll(".city-pill"),b=i&&p[i];if(b){let d=b.dataset.c.split("|");window.__hc=b.dataset.city;hcn.textContent=b.textContent;hcr.textContent=d[0];[hst,hsb,hsa].map((e,j)=>e.setAttribute("stop-color",d[j+1]));p[0].classList.remove("active");b.classList.add("active")}}catch{}</script>

    <!-- =================================================================== -->
    <!-- SECTION 2: HUMANITY'S PULSE (Calm Thin Strip, Real Live Score)      -->
    <!-- =================================================================== -->
    <section id="pulse" class="pulse-strip" aria-label={en.pulse.label}>
      <div class="story-container">
        <div class="pulse-inner">
          <div class="pulse-status-cluster">
            <span class="pulse-name" data-hr-t="pulse.label">{en.pulse.label}</span>
            <span class={`pulse-pill state-${pulseKey}`} data-hr-t={`pulse.states.${pulseKey}.word`}>{activePulse.word}</span>
          </div>

          <p class="pulse-sentence" data-hr-t={`pulse.states.${pulseKey}.sentence`}>{activePulse.sentence}</p>

          <div class="pulse-actions">
            <details class="pulse-tooltip">
              <summary class="pulse-tip-summary">
                <span aria-hidden="true">ⓘ</span> <span data-hr-t="pulse.tooltipTrigger">{en.pulse.tooltipTrigger}</span>
              </summary>
              <div class="pulse-tip-card">
                Technical reading: <strong>{rawPulseScore.toFixed(2)} / 10</strong> on the live system-speed and oversight monitor (checked periodically from open benchmarks).
              </div>
            </details>

            <a href={`${base}/seismograph/`} class="pulse-link">
              <span data-hr-t="pulse.cta">{en.pulse.cta}</span> <span class="arrow-flip" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- MEET TOTO (Guide Character Card, Directly After Pulse Strip)        -->
    <!-- =================================================================== -->
    <MeetTotoCard client:visible={{ rootMargin: '350px' }} base={base} />

    <!-- =================================================================== -->
    <!-- SECTIONS 3, 4 & 5: FIVE DOMAINS, FOUR MOMENTS & FIVE LIGHTS         -->
    <!-- =================================================================== -->
    <FiveDoorsPreview client:visible={{ rootMargin: '350px' }} base={base} />

    <!-- =================================================================== -->
    <!-- SECTION 6: CAN YOUR COUNTRY CATCH THE BREAKTHROUGH?                 -->
    <!-- =================================================================== -->
    <CountryCatchWidget client:visible={{ rootMargin: '500px' }} countries={countryCatalog} base={base} />

    <!-- =================================================================== -->
    <!-- SECTION 7: THIS WEEK WITH TOTO (Pilot Episode 1 Preview)            -->
    <!-- =================================================================== -->
    <section id="this-week" class="story-block defer-section defer-week">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title" data-hr-t="episode.heading">{en.episode.heading}</h2>
        </div>

        <div class="episode-grid">
          <article class="episode-card">
            <div class="ep-top">
              <span class="ep-badge" data-hr-t="episode.badge">{en.episode.badge}</span>
            </div>
            <h3 class="ep-title">Episode 1: &ldquo;<span data-hr-t="episode.title">{en.episode.title}</span>&rdquo;</h3>
            <p class="ep-body" data-hr-t="episode.synopsis">{en.episode.synopsis}</p>
            <div class="ep-real-life">
              <span class="rl-tag">REAL LIFE ACTION</span>
              <p>Keep one small paper note of essential family contacts and prescriptions offline so calm care continues even if digital tools hiccup.</p>
            </div>
            <p class="ep-note" data-hr-t="episode.voteNote">{en.episode.voteNote}</p>
          </article>

          <aside class="recap-card">
            <h3 class="recap-title" data-hr-t="episode.recapTitle">{en.episode.recapTitle}</h3>
            <p class="recap-body" data-hr-t="episode.recapBody">{en.episode.recapBody}</p>
            <p class="recap-status" data-hr-t="episode.recapStatus">{en.episode.recapStatus}</p>
          </aside>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 8: WHAT THE WORLD IS ASKING FOR (Invitation State n < 20)   -->
    <!-- =================================================================== -->
    <section id="wish-wall" class="story-block alt-surface defer-section defer-wall">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title" data-hr-t="wishWall.heading">{en.wishWall.heading}</h2>
        </div>

        <div class="wall-invitation-box">
          <div class="wall-themes" aria-label="Breakthrough themes">
            {en.wishWall.themes.map((theme, idx) => (
              <span class="theme-tag" data-hr-t={`wishWall.themes.${idx}`}>{theme}</span>
            ))}
          </div>
          <h3 class="wall-empty-head" data-hr-t="wishWall.emptyHeadline">{en.wishWall.emptyHeadline}</h3>
          <p class="wall-empty-body" data-hr-t="wishWall.emptyBody">{en.wishWall.emptyBody}</p>
          <a href="#wish-doors" class="btn-wall-cta">
            <span data-hr-t="wishWall.cta">{en.wishWall.cta}</span> <span class="arrow-flip" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 9: WHY A GREAT BREAKTHROUGH STILL NEEDS A READY WORLD       -->
    <!-- =================================================================== -->
    <section id="why-good-wisher" class="story-block defer-section defer-wisher">
      <div class="story-container">
        <div class="section-head">
          <h2 class="sec-title" data-hr-t="wisher.heading">{en.wisher.heading}</h2>
        </div>

        <div class="wisher-dual-grid">
          {en.wisher.cards.map((card, idx) => (
            <article class="wisher-card">
              <h3 class="wisher-title" data-hr-t={`wisher.cards.${idx}.title`}>{card.title}</h3>
              <p class="wisher-body" data-hr-t={`wisher.cards.${idx}.body`}>{card.body}</p>
              <details class="card-tech-note">
                <summary>ⓘ <span data-hr-t="pulse.tooltipTrigger">{en.pulse.tooltipTrigger}</span></summary>
                <p data-hr-t={`wisher.cards.${idx}.techHint`}>{card.techHint}</p>
              </details>
            </article>
          ))}
        </div>

        <p class="wisher-closing" data-hr-t="wisher.closingLine">{en.wisher.closingLine}</p>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- SECTION 10: GO DEEPER ("The research behind the story")             -->
    <!-- =================================================================== -->
    <GoDeeperSection client:visible={{ rootMargin: '450px' }} base={base} />
  </main>

  <HSRIFooter client:visible={{ rootMargin: '300px' }} />
</BaseLayout>

<style>
  .story-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  .story-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.15rem;
    box-sizing: border-box;
  }

  .story-block {
    contain: layout style;
    padding: clamp(2.25rem, 4.5vw, 3.75rem) 0;
    scroll-margin-top: 112px;
  }

  .defer-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 440px;
  }

  .defer-week {
    contain-intrinsic-size: auto 595px;
  }

  .defer-wall {
    contain-intrinsic-size: auto 437px;
  }

  .defer-wisher {
    contain-intrinsic-size: auto 426px;
  }

  .alt-surface {
    background: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .sec-title {
    font-family: var(--font-family-sans);
    font-size: clamp(1.5rem, 3.2vw, 2.15rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.55rem;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .sec-sub {
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  :global([dir='rtl']) .arrow-flip {
    display: inline-block;
    transform: scaleX(-1);
  }

  /* Section 2: Humanity's Pulse */
  .pulse-strip {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-medium);
    border-bottom: 1px solid var(--border-medium);
    padding: 0.95rem 0;
  }

  .pulse-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }

  .pulse-status-cluster {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  .pulse-name {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  .pulse-pill {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.22rem 0.65rem;
    border-radius: 9999px;
  }

  .pulse-pill.state-steady {
    background: var(--threat-sovereign-bg);
    color: var(--threat-sovereign);
    border: 1px solid var(--threat-sovereign-border);
  }

  .pulse-pill.state-stirring,
  .pulse-pill.state-rising {
    background: var(--threat-warning-bg);
    color: var(--threat-warning);
    border: 1px solid var(--threat-warning-border);
  }

  .pulse-sentence {
    margin: 0;
    flex: 1 1 320px;
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .pulse-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    position: relative;
  }

  .pulse-tooltip {
    position: relative;
  }

  .pulse-tip-summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
  }

  .pulse-tip-summary::-webkit-details-marker {
    display: none;
  }

  .pulse-tip-card {
    margin-top: 0.45rem;
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    font-size: 0.8rem;
    color: var(--text-secondary);
    max-width: 300px;
    box-shadow: var(--shadow-sm);
  }

  .pulse-link {
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--accent-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .pulse-link:hover {
    text-decoration: underline;
  }

  /* Section 7: Pilot Episode Teaser */
  .episode-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.15rem;
  }

  .episode-card,
  .recap-card {
    contain: layout style;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.35rem;
  }

  .ep-badge {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--threat-sovereign-bg);
    color: var(--threat-sovereign);
    margin-bottom: 0.55rem;
  }

  .ep-title,
  .recap-title {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.22rem;
    margin: 0 0 0.55rem;
    color: var(--text-primary);
  }

  .ep-body,
  .recap-body {
    margin: 0 0 0.9rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .ep-real-life {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-inline-start: 3px solid var(--accent-primary);
    border-radius: 10px;
    padding: 0.8rem 0.95rem;
    margin-bottom: 0.85rem;
  }

  .rl-tag {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--accent-primary);
    margin-bottom: 0.2rem;
  }

  .ep-real-life p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .ep-note,
  .recap-status {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Section 8: Wish Wall */
  .wall-invitation-box {
    max-width: 780px;
    margin: 0 auto;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 1.75rem 1.35rem;
    text-align: center;
  }

  .wall-themes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1.15rem;
  }

  .theme-tag {
    font-family: var(--font-family-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .wall-empty-head {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.18rem;
    margin: 0 0 0.5rem;
    color: var(--text-primary);
  }

  .wall-empty-body {
    margin: 0 auto 1.2rem;
    max-width: 580px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .btn-wall-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.35rem;
    border-radius: 10px;
    background: var(--accent-primary);
    color: var(--btn-primary-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .btn-wall-cta:hover {
    background: var(--accent-primary-hover);
  }

  /* Section 9: Why a good wish needs a good wisher */
  .wisher-dual-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.15rem;
    margin-bottom: 1.45rem;
  }

  .wisher-card {
    contain: layout style;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 14px;
    padding: 1.35rem;
  }

  .wisher-title {
    font-family: var(--font-family-sans);
    font-weight: 800;
    font-size: 1.22rem;
    margin: 0 0 0.55rem;
    color: var(--accent-primary);
  }

  .wisher-body {
    margin: 0 0 0.75rem;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--text-primary);
  }

  .card-tech-note summary {
    cursor: pointer;
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .card-tech-note p {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .wisher-closing {
    text-align: center;
    font-family: var(--font-family-sans);
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  @media (max-width: 960px) {
    .defer-week {
      contain-intrinsic-size: auto 552px;
    }
    .episode-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .defer-wall {
      contain-intrinsic-size: auto 440px;
    }
    .defer-wisher {
      contain-intrinsic-size: auto 390px;
    }
  }

  @media (max-width: 680px) {
    .story-block {
      padding: 1.55rem 0;
    }
    .section-head {
      margin-bottom: 1rem;
    }
    .episode-card,
    .recap-card {
      padding: 0.95rem;
    }
    .wall-invitation-box {
      padding: 1.1rem 0.95rem;
    }
    .wisher-dual-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
      margin-bottom: 0.9rem;
    }
    .wisher-card {
      padding: 0.85rem 0.95rem;
    }
    .wisher-title {
      font-size: 1.05rem;
      margin-bottom: 0.3rem;
    }
    .wisher-body {
      font-size: 0.88rem;
      line-height: 1.48;
      margin-bottom: 0.45rem;
    }
    .wisher-closing {
      font-size: 0.98rem;
    }
  }
</style>
