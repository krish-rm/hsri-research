---
// index.astro — Human-Centered Superintelligence Readiness Awareness Journey
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import InlineWedgeWidget from '../components/InlineWedgeWidget.svelte';
import CountryLookupWidget from '../components/CountryLookupWidget.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Human Superintelligence Readiness Index (HSRI) — When Machines Surpass Minds">
  <HSRIHeader client:load />

  <main class="awareness-canvas">
    <!-- ===================================================================== -->
    <!-- 1. HERO: THE HUMAN QUESTION -->
    <!-- ===================================================================== -->
    <section class="hero-section">
      <div class="content-container text-center">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span class="badge-text">HUMAN READINESS INITIATIVE · OPEN CONSORTIUM</span>
        </div>

        <h1 class="hero-headline">
          When Machines Surpass Human Minds,<br />
          <span class="gradient-headline">Will Civilization Hold?</span>
        </h1>

        <p class="hero-subhead">
          We are spending hundreds of billions building artificial intelligence faster than our own thoughts. 
          Yet almost nobody is asking the most urgent question: Can human society endure if we lose control, 
          or if the digital cloud goes dark?
        </p>

        <div class="hero-button-row">
          <a href="#the-gap" class="btn btn-primary btn-lg">
            Explore the Awareness Journey &darr;
          </a>
          <a href="#test-country" class="btn btn-secondary btn-lg">
            Test Your Country's Resilience &rarr;
          </a>
          <a href={`${base}/monograph/`} class="btn btn-ghost btn-lg">
            Read Full Monograph (35m)
          </a>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. THE MICROSECOND DIVIDE (The Speed Gap) -->
    <!-- ===================================================================== -->
    <section id="the-gap" class="section-container">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">01 · THE SPEED DIVIDE</span>
          <h2 class="section-title">We Cannot Steer What Moves Faster Than We Can Think</h2>
          <p class="section-intro">
            For thousands of years, every tool humans created waited for human reflexes. That physical boundary has broken.
          </p>
        </div>

        <!-- Visual Speed Cards -->
        <div class="comparison-grid">
          <div class="comp-card human-card">
            <div class="comp-meta">BIOLOGICAL CEILING</div>
            <div class="comp-metric">~200 ms</div>
            <div class="comp-title">Human Reflex Floor</div>
            <p class="comp-desc">
              The time it takes for light to enter your eye, travel through your optic nerve, and trigger a muscle contraction. 
              The blink of an eye.
            </p>
          </div>

          <div class="comp-card machine-card">
            <div class="comp-meta">SYNTHETIC VELOCITY</div>
            <div class="comp-metric">0.06 ms</div>
            <div class="comp-title">Machine Execution Loop</div>
            <p class="comp-desc">
              Frontier autonomous agents and trading swarms execute end-to-end reasoning and deployment in microseconds. 
              Over <strong>3,200 times faster</strong> than human awareness.
            </p>
          </div>
        </div>

        <div class="takeaway-box">
          <p class="takeaway-text">
            <strong>The Takeaway:</strong> In the time it takes you to read this sentence, an autonomous swarm can execute thousands 
            of financial orders, re-route high-voltage power lines, or deploy recursive code. 
            Human oversight is no longer operational; it is forensic. We arrive after the crash.
          </p>
        </div>

        <!-- Interactive Speed Slider -->
        <div class="interactive-panel">
          <InlineWedgeWidget client:visible />
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 3. THE ILLUSION OF CONTROL -->
    <!-- ===================================================================== -->
    <section class="section-container alt-bg">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">02 · THE CONTROL ILLUSION</span>
          <h2 class="section-title">Why There Is No "Red Button" for Modern Civilization</h2>
          <p class="section-intro">
            We comfort ourselves with the idea of a kill-switch. But in an automated world, pausing the machine means pausing life.
          </p>
        </div>

        <div class="locks-stack">
          <div class="lock-row">
            <div class="lock-lead">
              <span class="lock-icon" aria-hidden="true">⚡</span>
              <div class="lock-heading">
                <span class="lock-sub">SYSTEMIC LOCK 01</span>
                <h3>Grid &amp; Energy Locks</h3>
              </div>
            </div>
            <div class="lock-body">
              <p>
                Power distribution across modern electrical grids requires continuous microsecond phase balancing. 
                If algorithmic controllers are severed, automated sub-stations trip to prevent turbine damage—blacking out entire national grids within seconds.
              </p>
            </div>
            <div class="lock-impact">
              <span class="impact-badge critical">FAILURE IN &lt; 2 SECONDS</span>
              <span class="impact-note">Zero manual dispatcher fallback</span>
            </div>
          </div>

          <div class="lock-row">
            <div class="lock-lead">
              <span class="lock-icon" aria-hidden="true">🚢</span>
              <div class="lock-heading">
                <span class="lock-sub">SYSTEMIC LOCK 02</span>
                <h3>Autonomous Logistics</h3>
              </div>
            </div>
            <div class="lock-body">
              <p>
                Container cranes, automated cargo sorting, and long-haul rail routing run on cloud optimization. 
                No workforce remains on modern docks capable of manually sorting 50,000 maritime containers without real-time database manifests.
              </p>
            </div>
            <div class="lock-impact">
              <span class="impact-badge warning">SUPPLY HALT: 12–24 HOURS</span>
              <span class="impact-note">Port throughput collapses &gt; 90%</span>
            </div>
          </div>

          <div class="lock-row">
            <div class="lock-lead">
              <span class="lock-icon" aria-hidden="true">🏥</span>
              <div class="lock-heading">
                <span class="lock-sub">SYSTEMIC LOCK 03</span>
                <h3>Hospital &amp; Civic Data</h3>
              </div>
            </div>
            <div class="lock-body">
              <p>
                Prescription verification, automated pharmaceutical dispensing, ICU bed allocation, and diagnostic triage are deeply intertwined with cloud APIs. 
                Severing access immediately degrades clinical throughput, creating cascading emergency room paralysis.
              </p>
            </div>
            <div class="lock-impact">
              <span class="impact-badge severe">CAPACITY LOSS: UP TO 80%</span>
              <span class="impact-note">Emergency triage paralyzes</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 4. THE FRAGILITY TRAP -->
    <!-- ===================================================================== -->
    <section class="section-container">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">03 · THE ABUNDANCE PARADOX</span>
          <h2 class="section-title">Why the Most High-Tech Nations Are Often the Most Fragile</h2>
          <p class="section-intro">
            In the name of efficiency, modern economies threw away paper records, local grain silos, and analog manual levers.
          </p>
        </div>

        <!-- Timeline of Blackout -->
        <div class="cliff-timeline">
          <div class="timeline-step">
            <div class="timeline-step-header">
              <span class="timeline-phase">PHASE 01</span>
              <div class="step-hour">HOUR 0 – 6</div>
            </div>
            <div class="step-content">
              <h4>Digital Severance</h4>
              <p>Foreign cloud APIs disconnect. Automated financial clearing freezes; container port crane scheduling halts.</p>
            </div>
          </div>

          <div class="timeline-step">
            <div class="timeline-step-header">
              <span class="timeline-phase">PHASE 02</span>
              <div class="step-hour">HOUR 12 – 24</div>
            </div>
            <div class="step-content">
              <h4>Supply Chain Paralysis</h4>
              <p>Just-in-time grocery distribution fails. Supermarket shelves empty as automated restocking dispatches cease.</p>
            </div>
          </div>

          <div class="timeline-step highlight-step">
            <div class="timeline-step-header">
              <span class="timeline-phase critical">PHASE 03 · THE CLIFF</span>
              <div class="step-hour highlight-hour">HOUR 48+</div>
            </div>
            <div class="step-content">
              <h4>The Civilizational Cliff</h4>
              <p>Municipal water treatment backup fuels exhaust; regional grid coordination desynchronizes without cloud telemetries.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 5. TEST YOUR COUNTRY (Interactive Resilience Audit) -->
    <!-- ===================================================================== -->
    <section id="test-country" class="section-container alt-bg">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">04 · SOVEREIGN RESILIENCE AUDIT</span>
          <h2 class="section-title">How Long Does Your Nation Endure Without the Cloud?</h2>
          <p class="section-intro">
            We audited 39 benchmark economies to measure their <strong>Decoupling Half-Life</strong>—how many hours basic societal functions survive under digital severance.
          </p>
        </div>

        <!-- Interactive Country Widget -->
        <div class="lookup-wrapper">
          <CountryLookupWidget client:idle preselectCode="USA" showHeader={false} />
        </div>

        <div class="scoreboard-bridge-row">
          <a href={`${base}/countries/`} class="btn btn-secondary btn-lg">
            View All 39 Countries on the Full Decoupling Scoreboard &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 6. THREE HUMAN SAFEGUARDS (Solutions) -->
    <!-- ===================================================================== -->
    <section class="section-container">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">05 · THE PATH FORWARD</span>
          <h2 class="section-title">Three Concrete Safeguards for Human Sovereignty</h2>
          <p class="section-intro">
            Preparing for superintelligence is not about halting progress. It is about building civilizational life-rafts before the storm.
          </p>
        </div>

        <div class="safeguards-stack">
          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">01</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 01</span>
                <h3>The 72-Hour Analog Override</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Every critical facility—hospitals, water utilities, electrical substations, and ports—must legally maintain an 
                air-gapped manual control system capable of operating for 72 hours without internet or cloud authentication.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">72h Air-Gapped Autarky</span>
            </div>
          </div>

          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">02</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 02</span>
                <h3>Sovereign Reserves &amp; Microgrids</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Governments must mandate local buffer inventories for food, critical medicines, and domestic municipal microgrids, 
                protecting societies against catastrophic single-point cloud dependencies.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">Physical Buffer Inventories</span>
            </div>
          </div>

          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">03</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 03</span>
                <h3>Continuous Open Telemetry</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Moving beyond non-binding political summits toward empirical sensing. Tracking machine-to-machine autonomy 
                expansion in real-time to detect dangerous acceleration before it triggers civilizational shock.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">Live Empirical Sensing</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 7. RESEARCH & DEEP VERIFICATION HUB -->
    <!-- ===================================================================== -->
    <section class="section-container alt-bg">
      <div class="content-container">
        <div class="section-header">
          <span class="section-step">06 · SCIENTIFIC RIGOR &amp; DEEP EXPLORATION</span>
          <h2 class="section-title">Deep Research &amp; Interactive Engines</h2>
          <p class="section-intro">
            Every metric and conclusion on this site is backed by peer-reviewed literature, reproducible mathematical engines, and live data feeds.
          </p>
        </div>

        <div class="hub-cards-grid">
          <a href={`${base}/monograph/`} class="hub-feature-card">
            <div class="hub-tag">FULL TREATISE</div>
            <h3>The Civilizational Monograph &rarr;</h3>
            <p>A comprehensive 35-minute scientific inquest with mathematical proofs, Rice theorem formalizations, and actuarial tail-risk models.</p>
            <span class="hub-link-text">Read the Monograph</span>
          </a>

          <a href={`${base}/seismograph/`} class="hub-feature-card">
            <div class="hub-tag">LIVE TELEMETRY</div>
            <h3>The Precursor Seismograph &rarr;</h3>
            <p>Real-time empirical tracking of the Verification Latency Wedge, machine autonomy transaction volume, and token drift.</p>
            <span class="hub-link-text">View Live Telemetry (8.44/10)</span>
          </a>

          <a href={`${base}/research/decoupling-drill/`} class="hub-feature-card">
            <div class="hub-tag">TABLETOP SIMULATION</div>
            <h3>The Decoupling Crisis Drill &rarr;</h3>
            <p>An interactive 72-hour zero-notice blackout simulation for policy leaders, civil defense directors, and risk officers.</p>
            <span class="hub-link-text">Launch Simulation</span>
          </a>

          <a href={`${base}/data/`} class="hub-feature-card">
            <div class="hub-tag">OPEN SCIENCE</div>
            <h3>Open Data &amp; Reproducible Engine &rarr;</h3>
            <p>Download full CSV/JSON datasets, explore the Docker API, and inspect our permanent DOI 10.5281/zenodo.23441742 registration.</p>
            <span class="hub-link-text">Access Data &amp; Code</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <HSRIFooter client:visible />
</BaseLayout>

<style>
  /* ========================================================================= */
  /* Awareness Canvas & Typography                                            */
  /* ========================================================================= */
  .awareness-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .text-center {
    text-align: center;
  }

  .alt-bg {
    background-color: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* ========================================================================= */
  /* Hero Section                                                             */
  /* ========================================================================= */
  .hero-section {
    padding: 5.5rem 0 5rem;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    margin-bottom: 2rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary);
    animation: pulse 2.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .badge-text {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .hero-headline {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }

  .gradient-headline {
    background: linear-gradient(135deg, var(--accent-primary) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subhead {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 740px;
    margin: 0 auto 2.75rem;
  }

  .hero-button-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .btn-lg {
    padding: 0.85rem 1.65rem;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: #0b0f17;
  }
  .btn-primary:hover {
    background: var(--accent-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--accent-primary-glow);
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }
  .btn-secondary:hover {
    border-color: var(--accent-primary);
    background: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  /* ========================================================================= */
  /* Section Standards                                                         */
  /* ========================================================================= */
  .section-container {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-step {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    display: inline-block;
    margin-bottom: 0.65rem;
  }

  .section-title {
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .section-intro {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ========================================================================= */
  /* Comparison Grid (Speed Divide)                                           */
  /* ========================================================================= */
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .comp-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 12px;
    padding: 2.25rem 2rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .comp-card:hover {
    transform: translateY(-2px);
  }

  .human-card {
    border-left: 4px solid var(--text-muted);
  }

  .machine-card {
    border-left: 4px solid var(--threat-critical);
  }

  .comp-meta {
    font-family: var(--font-family-mono);
    font-size: 0.70rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .comp-metric {
    font-family: var(--font-family-mono);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .human-card .comp-metric {
    color: var(--text-secondary);
  }
  .machine-card .comp-metric {
    color: var(--threat-critical);
  }

  .comp-title {
    font-size: 1.20rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .comp-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .takeaway-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.25rem 1.75rem;
    margin-bottom: 2.5rem;
  }

  .takeaway-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-primary);
    margin: 0;
  }

  .interactive-panel {
    max-width: 860px;
    margin: 0 auto;
  }

  /* ========================================================================= */
  /* Executive Horizontal Locks Stack (Section 02)                              */
  /* ========================================================================= */
  .locks-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lock-row {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 1.75rem 2rem;
    display: grid;
    grid-template-columns: 290px 1fr 220px;
    align-items: center;
    gap: 2rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .lock-row:hover {
    transform: translateX(4px);
    border-color: var(--border-medium);
    box-shadow: var(--shadow-md);
  }

  .lock-lead {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .lock-icon {
    font-size: 2.2rem;
    flex-shrink: 0;
  }

  .lock-heading {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lock-sub {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .lock-heading h3 {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .lock-body p {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .lock-impact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .impact-badge {
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    display: inline-block;
    white-space: nowrap;
  }

  .impact-badge.critical {
    background: var(--threat-critical-bg, rgba(239, 68, 68, 0.15));
    color: var(--threat-critical, #ef4444);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .impact-badge.warning {
    background: var(--threat-elevated-bg, rgba(245, 158, 11, 0.15));
    color: var(--threat-elevated, #f59e0b);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .impact-badge.severe {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .impact-note {
    font-size: 0.76rem;
    color: var(--text-muted);
