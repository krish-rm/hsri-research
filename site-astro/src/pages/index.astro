---
// index.astro — Minimal 3-Step Story-First Entry Page
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HeroStory from '../components/HeroStory.svelte';
import FiveDoorsPreview from '../components/FiveDoorsPreview.svelte';
import CountryCatchWidget from '../components/CountryCatchWidget.svelte';
import GoDeeperSection from '../components/GoDeeperSection.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import precursorSummary from '../data/precursor_summary.json';
import { buildCountryWidgetCatalog } from '../lib/countryData';
import { en } from '../i18n/en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rawPulseScore = Number(precursorSummary.master_precursor_threat_score ?? 8.44);
const pulseKey: 'steady' | 'stirring' | 'rising' =
  rawPulseScore < 4.0 ? 'steady' : rawPulseScore < 7.0 ? 'stirring' : 'rising';

const starterIsos = new Set(['NOR', 'DEU', 'JPN', 'USA', 'SGP', 'BRA', 'IND', 'NGA']);
const countryCatalog = buildCountryWidgetCatalog().filter((c) => starterIsos.has(c.iso));
---

<BaseLayout title={en.meta.title} description={en.meta.description}>
  <HSRIHeader client:interact currentPath={Astro.url.pathname} showStatsBar={false} />

  <main class="story-canvas">
    <!-- STEP 1: CLEAN SINGLE-SCREEN HERO -->
    <HeroStory client:interact base={base} pulseKey={pulseKey} pulseScore={rawPulseScore} />
    <script is:inline>try{let p={Lagos:1,Sao_Paulo:1,Kolkata:1,Calcutta:1,Berlin:1,Jakarta:1,Dubai:1,Nairobi:1},m={Lagos:["lagos","Africa"],Sao_Paulo:["saopaulo","Americas"],Kolkata:["mumbai","South Asia"],Calcutta:["mumbai","South Asia"],Berlin:["berlin","Europe"],Jakarta:["jakarta","Asia & Middle East"],Dubai:["dubai","Middle East"],Nairobi:["nairobi","Africa"],Tokyo:["jpn","Asia & Middle East"],Cairo:["egy","Africa"],London:["gbr","Europe"],Paris:["fra","Europe"],New_York:["usa","Americas"],Chicago:["usa","Americas"],Los_Angeles:["usa","Americas"],Toronto:["can","Americas"],Vancouver:["can","Americas"],Seoul:["kor","Asia & Middle East"],Shanghai:["chn","Asia & Middle East"],Sydney:["aus","Oceania"],Melbourne:["aus","Oceania"],Singapore:["sgp","Asia & Middle East"],Bangkok:["tha","Asia & Middle East"],Oslo:["nor","Europe"],Stockholm:["swe","Europe"],Helsinki:["fin","Europe"],Copenhagen:["dnk","Europe"],Reykjavik:["isl","Europe"],Mexico_City:["mex","Americas"],Lima:["per","Americas"],Buenos_Aires:["arg","Americas"],Santiago:["chl","Americas"],Johannesburg:["zaf","Africa"],Addis_Ababa:["eth","Africa"],Casablanca:["mar","Africa"],Istanbul:["tur","Middle East"],Riyadh:["sau","Middle East"],Qatar:["qat","Middle East"],Rome:["ita","Europe"],Madrid:["esp","Europe"],Lisbon:["prt","Europe"],Amsterdam:["nld","Europe"],Warsaw:["pol","Europe"],Athens:["grc","Europe"],Vienna:["aut","Europe"],Prague:["cze","Europe"],Kathmandu:["npl","South Asia"],Karachi:["pak","South Asia"],Dhaka:["bgd","South Asia"],Colombo:["lka","South Asia"],Manila:["phl","Asia & Middle East"],Ho_Chi_Minh:["vnm","Asia & Middle East"],Taipei:["twn","Asia & Middle East"],Hong_Kong:["hkg","Asia & Middle East"],Auckland:["nzl","Oceania"]},k=Intl.DateTimeFormat().resolvedOptions().timeZone.split("/").pop(),c=m[k];if(c){window.__hc=c[0];let sel=document.getElementById("hero-city-select"),bg=document.getElementById("hero-city-bg"),cn=document.getElementById("hcn"),cr=document.getElementById("hcr");if(sel){sel.value=c[0];if(cn&&sel.selectedIndex>=0)cn.textContent=sel.options[sel.selectedIndex].text}if(cr)cr.textContent=c[1];if(bg){let f=p[k]?c[0]:"dawn-sky-base";bg.setAttribute("src",(bg.getAttribute("src")||"").replace(/\/assets\/cities\/[^.]+\.webp/,"/assets/cities/"+f+".webp"))}}}catch{}</script>

    <!-- STEP 2: 60-SECOND BREAKTHROUGH EXPLORER & COMPACT 5 LIGHTS -->
    <FiveDoorsPreview client:interact base={base} />

    <!-- STEP 3: COMPACT COUNTRY READINESS SNAPSHOT -->
    <CountryCatchWidget client:interact countries={countryCatalog} base={base} />

    <!-- COMPACT RESEARCH & STORIES BAR -->
    <GoDeeperSection client:interact base={base} />
  </main>

  <HSRIFooter client:interact />
</BaseLayout>

<style>
  .story-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }
</style>
