---
// index.astro — Human-Centered Superintelligence Readiness Awareness Journey
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import VisualScenarioTheater from '../components/VisualScenarioTheater.svelte';
import InlineWedgeWidget from '../components/InlineWedgeWidget.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Humanity Superintelligence Readiness Index (HSRI) — When Machines Surpass Minds">
  <HSRIHeader client:load />

  <main class="awareness-canvas">
    <!-- ===================================================================== -->
    <!-- 1. HERO: THE HUMAN QUESTION -->
    <!-- ===================================================================== -->
    <section class="hero-section">
      <div class="content-container text-center">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span class="badge-text">HUMANITY READINESS INITIATIVE · OPEN CONSORTIUM</span>
        </div>

        <h1 class="hero-headline">
          When Machines Surpass Human Minds,<br />
          <span class="gradient-headline">Will Civilization Hold?</span>
        </h1>

        <p class="hero-subhead">
          We are spending hundreds of billions building artificial intelligence faster than our own thoughts. 
          Yet almost nobody is asking the most urgent question: <strong>Can human civilization physically endure if the digital cloud goes dark?</strong>
        </p>

        <!-- Differentiator Callout -->
        <div class="hero-paradox-callout">
          <span class="paradox-pill">THE WEAKEST-LINK PARADOX</span>
          <span class="paradox-text">Under cloud severance, <strong>Singapore drops 40 ranks</strong> and the <strong>US drops 37</strong>, while <strong>Norway holds #1</strong>. We test sovereign survival, not software adoption.</span>
        </div>

        <div class="hero-button-row">
          <a href="#visual-theater" class="btn btn-primary btn-lg">
            Watch Scenario Storyboard &darr;
          </a>
          <a href={`${base}/sandbox/`} class="btn btn-secondary btn-lg">
            Launch Sandbox Workbench &rarr;
          </a>
          <a href={`${base}/countries/`} class="btn btn-ghost btn-lg">
            View 41-Nation Index
          </a>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. THE VISUAL SCENARIO THEATER (STORY BEFORE NUMBERS)                 -->
    <!-- ===================================================================== -->
    <div id="visual-theater">
      <VisualScenarioTheater client:visible />
    </div>

    <!-- ===================================================================== -->
    <!-- 3. THE STRUCTURAL MECHANISM: TWO PHYSICAL REALITIES                   -->
    <!-- ===================================================================== -->
    <section id="the-mechanism" class="section-container">
      <div class="content-container">
        <div class="section-header text-center">
          <span class="section-step">THE CORE THESIS · TWO PHYSICAL REALITIES</span>
          <h2 class="section-title">Why Civilization Cannot Steer or Pause the Machine</h2>
          <p class="section-intro">
            Superintelligence breaks the Westphalian nation-state not through malice, but through basic physical laws: execution velocity and structural dependency.
          </p>
        </div>

        <div class="thesis-dual-grid">
          <!-- Card 1: The Speed Divide -->
          <div class="thesis-card">
            <div class="tc-header">
              <span class="tc-eyebrow">PHYSICAL REALITY 01 · TEMPORAL ASYMMETRY</span>
              <h3 class="tc-title">We Cannot Steer What Moves Faster Than We Can Think</h3>
              <p class="tc-body">
                For thousands of years, every tool humans created waited for biological reflexes (~200ms). That physical boundary has broken. Frontier swarms execute in microseconds—over 3,200x faster than human thought. Human oversight is no longer operational; it is forensic. We arrive after the crash.
              </p>
            </div>

            <div class="speed-mini-metrics">
              <div class="smm-box">
                <span class="smm-label">Biological Reflex Floor</span>
                <span class="smm-val">~200 ms</span>
                <span class="smm-sub">Human neural threshold</span>
              </div>
              <div class="smm-box">
                <span class="smm-label">Synthetic Velocity Loop</span>
                <span class="smm-val divergent">0.06 ms</span>
                <span class="smm-sub">3,200x supervisory divergence</span>
              </div>
            </div>

            <div class="tc-widget-wrapper">
              <InlineWedgeWidget client:visible />
            </div>
          </div>

          <!-- Card 2: The Leontief Floor -->
          <div class="thesis-card">
            <div class="tc-header">
              <span class="tc-eyebrow">PHYSICAL REALITY 02 · STRUCTURAL DEPENDENCY</span>
              <h3 class="tc-title">Why Civilization Has No "Pause Button"</h3>
              <p class="tc-body">
                We comfort ourselves with the idea of a kill-switch. But in an automated society, pausing the machine pauses life. A modern economy is bounded by its lowest physical autarky layer (Leontief weakest link), not its software GDP.
              </p>
            </div>

            <div class="structural-locks-list">
              <div class="sll-item">
                <span class="sll-icon" aria-hidden="true">⚡</span>
                <div class="sll-content">
                  <h4>Grid &amp; Energy Locks</h4>
                  <p>Substations trip in &lt;2s without microsecond phase balancing.</p>
                </div>
                <span class="sll-badge">&lt; 2s Halftime</span>
              </div>

              <div class="sll-item">
                <span class="sll-icon" aria-hidden="true">🚢</span>
                <div class="sll-content">
                  <h4>Autonomous Logistics</h4>
                  <p>Container cranes &amp; rail routing halt without live cloud manifests.</p>
                </div>
                <span class="sll-badge">12–24h Halt</span>
              </div>

              <div class="sll-item">
                <span class="sll-icon" aria-hidden="true">🏥</span>
                <div class="sll-content">
                  <h4>Hospital &amp; Civic Data</h4>
                  <p>Emergency triage and ICU dispensing degrade by up to 80%.</p>
                </div>
                <span class="sll-badge">-80% Triage</span>
              </div>
            </div>

            <div class="contrast-mini-box">
              <div class="cmb-header">SOVEREIGN VULNERABILITY CONTRAST</div>
              <div class="cmb-rows">
                <div class="cmb-row">
                  <div class="cmb-meta">
                    <span class="cmb-country">Singapore (SGP)</span>
                    <span class="cmb-note">95% gas import · Halts in 18h</span>
                  </div>
                  <span class="cmb-drop neg">Drops 40 Ranks</span>
                </div>
                <div class="cmb-row">
                  <div class="cmb-meta">
                    <span class="cmb-country">Norway (NOR)</span>
                    <span class="cmb-note">100% hydro · Grain buffer · 72h+ autarky</span>
                  </div>
                  <span class="cmb-drop pos">Holds Rank #1</span>
                </div>
              </div>
            </div>

            <div class="tc-action-row">
              <a href={`${base}/sandbox/`} class="btn btn-secondary btn-block">
                Stress-Test 41 Nations in the Sandbox Workbench &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 4. THREE HUMAN SAFEGUARDS (Solutions)                                -->
    <!-- ===================================================================== -->
    <section class="section-container alt-bg">
      <div class="content-container">
        <div class="section-header text-center">
          <span class="section-step">02 · THE PATH FORWARD</span>
          <h2 class="section-title">Three Concrete Safeguards for Human Sovereignty</h2>
          <p class="section-intro">
            Preparing for superintelligence is not about halting progress. It is about building civilizational life-rafts before the storm.
          </p>
        </div>

        <div class="safeguards-stack">
          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">01</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 01</span>
                <h3>The 72-Hour Analog Override</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Every critical facility—hospitals, water utilities, electrical substations, and ports—must legally maintain an 
                air-gapped manual control system capable of operating for 72 hours without internet or cloud authentication.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">72h Air-Gapped Autarky</span>
            </div>
          </div>

          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">02</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 02</span>
                <h3>Sovereign Reserves &amp; Microgrids</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Governments must mandate local buffer inventories for food, critical medicines, and domestic municipal microgrids, 
                protecting societies against catastrophic single-point cloud dependencies.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">Physical Buffer Inventories</span>
            </div>
          </div>

          <div class="safeguard-row">
            <div class="safeguard-lead">
              <span class="mandate-num">03</span>
              <div class="safeguard-heading">
                <span class="mandate-pill">SOVEREIGN MANDATE 03</span>
                <h3>Continuous Open Telemetry</h3>
              </div>
            </div>
            <div class="safeguard-body">
              <p>
                Moving beyond non-binding political summits toward empirical sensing. Tracking machine-to-machine autonomy 
                expansion in real-time to detect dangerous acceleration before it triggers civilizational shock.
              </p>
            </div>
            <div class="safeguard-target">
              <span class="target-badge">DEFENSE GOAL</span>
              <span class="target-val">Live Empirical Sensing</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 5. RESEARCH & INTERACTIVE ENGINES (The 4 Discovery Hubs)             -->
    <!-- ===================================================================== -->
    <section class="section-container">
      <div class="content-container">
        <div class="section-header text-center">
          <span class="section-step">03 · SCIENTIFIC RIGOR &amp; DEEP EXPLORATION</span>
          <h2 class="section-title">Deep Research &amp; Interactive Engines</h2>
          <p class="section-intro">
            Every metric and conclusion on this site is backed by peer-reviewed literature, reproducible mathematical engines, and live data feeds.
          </p>
        </div>

        <div class="hub-cards-grid">
          <a href={`${base}/sandbox/`} class="hub-feature-card">
            <div class="hub-tag">DYNAMIC SIMULATION</div>
            <h3>The Civilizational Sandbox &rarr;</h3>
            <p>Interactive 2026–2030 Post-Westphalian simulation of systemic fracture, transition, and survival across 41 benchmark economies.</p>
            <span class="hub-link-text">Launch Sandbox Engine</span>
          </a>

          <a href={`${base}/countries/`} class="hub-feature-card">
            <div class="hub-tag">EMPIRICAL BASELINE</div>
            <h3>The 41-Nation Country Index &rarr;</h3>
            <p>Sovereign resilience audit measuring Leontief weakest-link floors, energy autarky, and survival half-lives.</p>
            <span class="hub-link-text">Explore Full Country Index</span>
          </a>

          <a href={`${base}/seismograph/`} class="hub-feature-card">
            <div class="hub-tag">LIVE TELEMETRY</div>
            <h3>The Precursor Seismograph &rarr;</h3>
            <p>Real-time empirical tracking of the Verification Latency Wedge, machine autonomy transaction volume, and token drift.</p>
            <span class="hub-link-text">View Live Telemetry (8.44/10)</span>
          </a>

          <a href={`${base}/monograph/`} class="hub-feature-card">
            <div class="hub-tag">PEER-REVIEWED TREATISE</div>
            <h3>The Civilizational Monograph &rarr;</h3>
            <p>A comprehensive 35-minute scientific inquest with mathematical proofs, Rice theorem formalizations, and actuarial tail-risk models.</p>
            <span class="hub-link-text">Read the Monograph</span>
          </a>
        </div>

        <div class="hub-secondary-nav">
          <span class="hub-sub-label">Additional Research &amp; Data:</span>
          <a href={`${base}/scenarios/`}>The 26-Pathway Scenario Atlas</a>
          <span class="sep">&bull;</span>
          <a href={`${base}/research/decoupling-drill/`}>Decoupling Crisis Drill</a>
          <span class="sep">&bull;</span>
          <a href={`${base}/data/`}>Open Data &amp; Zenodo DOI 10.5281/zenodo.23441742</a>
        </div>
      </div>
    </section>
  </main>

  <HSRIFooter client:visible />
</BaseLayout>

<style>
  /* ========================================================================= */
  /* Awareness Canvas & Typography                                            */
  /* ========================================================================= */
  .awareness-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .text-center {
    text-align: center;
  }

  .alt-bg {
    background-color: var(--bg-surface-sunken);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* ========================================================================= */
  /* Hero Section                                                             */
  /* ========================================================================= */
  .hero-section {
    padding: 5.5rem 0 5rem;
    position: relative;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    margin-bottom: 2rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary);
    animation: pulse 2.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.85); }
  }

  .badge-text {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .hero-headline {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }

  .gradient-headline {
    background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-gradient-end, #38bdf8) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subhead {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 740px;
    margin: 0 auto 1.5rem;
  }

  .hero-paradox-callout {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-medium);
    border-radius: 9999px;
    padding: 0.4rem 1.15rem;
    margin: 0 auto 2.25rem;
    max-width: 820px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .paradox-pill {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    background: var(--threat-critical, #b91c1c);
    color: #ffffff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .paradox-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .hero-button-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .btn-lg {
    padding: 0.85rem 1.65rem;
    font-size: 0.95rem;
  }

  .btn-primary {
    background: var(--accent-primary);
    color: var(--btn-primary-text, #ffffff);
  }
  .btn-primary:hover {
    background: var(--accent-primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--accent-primary-glow);
  }

  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }
  .btn-secondary:hover {
    border-color: var(--accent-primary);
    background: var(--bg-surface-elevated);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .btn-block {
    width: 100%;
  }

  /* ========================================================================= */
  /* Section Standards                                                         */
  /* ========================================================================= */
  .section-container {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-step {
    font-family: var(--font-family-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    display: inline-block;
    margin-bottom: 0.65rem;
  }

  .section-title {
    font-size: 2.35rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .section-intro {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ========================================================================= */
  /* Two Physical Realities: Dual Grid                                         */
  /* ========================================================================= */
  .thesis-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .thesis-card {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .thesis-card:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-md);
  }

  .tc-header {
    margin-bottom: 1.25rem;
  }

  .tc-eyebrow {
    font-family: var(--font-family-mono);
    font-size: 0.70rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .tc-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0 0 0.85rem;
  }

  .tc-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Card 1: Speed Divide Elements */
  .speed-mini-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0 1.25rem;
  }

  .smm-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .smm-label {
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .smm-val {
    font-family: var(--font-family-mono);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .smm-val.divergent {
    color: var(--threat-critical, #ef4444);
  }

  .smm-sub {
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .tc-widget-wrapper {
    margin-top: auto;
  }

  .tc-widget-wrapper :global(.wedge-widget-card) {
    margin: 0 !important;
    background: var(--bg-surface) !important;
    border-color: var(--border-subtle) !important;
  }

  /* Card 2: Leontief Structural Locks */
  .structural-locks-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.25rem 0;
  }

  .sll-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.75rem 1rem;
  }

  .sll-icon {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .sll-content {
    flex-grow: 1;
  }

  .sll-content h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.15rem;
    line-height: 1.2;
  }

  .sll-content p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  .sll-badge {
    font-family: var(--font-family-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--threat-critical, #ef4444);
    background: var(--threat-critical-bg, rgba(239, 68, 68, 0.12));
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Contrast Mini Box */
  .contrast-mini-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 0.85rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .cmb-header {
    font-family: var(--font-family-mono);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .cmb-rows {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .cmb-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px dashed var(--border-subtle);
  }

  .cmb-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cmb-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .cmb-country {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cmb-note {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .cmb-drop {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .cmb-drop.neg {
    color: var(--threat-critical, #ef4444);
