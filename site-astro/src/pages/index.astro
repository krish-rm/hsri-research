---
// index.astro — Minimal 3-Step Story-First Entry Page
import BaseLayout from '../layouts/BaseLayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HeroStory from '../components/HeroStory.svelte';
import FiveDoorsPreview from '../components/FiveDoorsPreview.svelte';
import CountryCatchWidget from '../components/CountryCatchWidget.svelte';
import HumanitysPulseSection from '../components/HumanitysPulseSection.svelte';
import GoDeeperSection from '../components/GoDeeperSection.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import precursorSummary from '../data/precursor_summary.json';
import { buildCountryWidgetCatalog } from '../lib/countryData';
import { COUNTRY_SKIES } from '../lib/countrySkies';
import { ISO3_TO_ISO2 } from '../i18n/locales';
import heritageIndex from '../data/heritage/index.json';
import { en } from '../i18n/en';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rawPulseScore = Number(precursorSummary.master_precursor_threat_score ?? 8.44);
const pulseKey: 'steady' | 'stirring' | 'rising' =
  rawPulseScore < 4.0 ? 'steady' : rawPulseScore < 7.0 ? 'stirring' : 'rising';

const starterIsos = new Set([
  'NOR', 'DEU', 'JPN', 'USA', 'SGP', 'BRA', 'IND', 'NGA',
  'ARE', 'GBR', 'FRA', 'CAN', 'AUS', 'EGY', 'SAU', 'KEN',
  'ZAF', 'IDN', 'KOR', 'CHN', 'MEX', 'TUR', 'PAK', 'BGD',
  'NPL', 'PHL', 'THA', 'VNM'
]);
const fullCountryCatalog = buildCountryWidgetCatalog();
const countryCatalog = fullCountryCatalog.filter((c) => starterIsos.has(c.iso));

// Compact 148-country pre-paint detection index derived from single sources of truth
const skyByIso = new Map(COUNTRY_SKIES.filter((s) => s.iso !== 'GLOBAL').map((s) => [s.iso, s]));
const autoSkyRows = COUNTRY_SKIES.filter((s) => s.iso !== 'GLOBAL').map((s) => [
  s.id,
  s.iso,
  s.country,
  s.regionHint,
  s.painted ? 1 : 0,
  ...s.tzPrefixes
]);
const autoIso2: Record<string, string> = { UK: 'gbr' };
for (const [iso3, iso2] of Object.entries(ISO3_TO_ISO2)) {
  const sky = skyByIso.get(iso3);
  if (sky) autoIso2[iso2] = sky.id;
}
const autoFullNames: Record<string, string> = {};
for (const c of fullCountryCatalog) {
  const sky = skyByIso.get(c.iso);
  if (sky && c.name !== sky.country) autoFullNames[c.iso] = c.name;
}
const autoTraditions: Record<string, string> = {};
for (const h of heritageIndex) {
  for (const iso of h.countries) {
    if (!autoTraditions[iso]) autoTraditions[iso] = h.traditionLabel.en;
  }
}
const geoData = {
  rows: autoSkyRows,
  iso2: autoIso2,
  full: autoFullNames,
  trad: autoTraditions
};
---

<BaseLayout title={en.meta.title} description={en.meta.description}>
  <HSRIHeader client:interact currentPath={Astro.url.pathname} showStatsBar={false} />

  <main class="story-canvas">
    <!-- STEP 1: CLEAN SINGLE-SCREEN HERO -->
    <HeroStory client:interact base={base} />
    <script is:inline define:vars={{ geoData }}>
      try {
        var _p = new URLSearchParams(window.location.search);
        var _uLang = _p.get("lang");
        var _sLoc = localStorage.getItem("hr:v1:locale");
        var _isEn = !_uLang && (!_sLoc || _sLoc === "en");
        var _cParam = (_p.get("c") || "").trim().toLowerCase();
        var rows = geoData.rows || [];
        var matched = null;
        if (_cParam) {
          for (var i = 0; i < rows.length; i++) {
            if (rows[i][0] === _cParam || rows[i][1].toLowerCase() === _cParam) { matched = rows[i]; break; }
          }
        }
        if (!matched) {
          var tz = "";
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) {}
          if (tz) {
            for (var i = 0; i < rows.length && !matched; i++) {
              var r = rows[i];
              for (var j = 5; j < r.length; j++) {
                if (tz.indexOf(r[j]) === 0) { matched = r; break; }
              }
            }
          }
        }
        if (!matched) {
          var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]) || [];
          for (var k = 0; k < langs.length && !matched; k++) {
            var tag = langs[k] || "";
            var parts = tag.split(/[-_]/);
            var reg = "";
            for (var q = 1; q < parts.length; q++) {
              if (/^[A-Za-z]{2}$/.test(parts[q])) { reg = parts[q].toUpperCase(); break; }
            }
            var idHit = reg ? geoData.iso2[reg] : "";
            if (idHit) {
              for (var m = 0; m < rows.length; m++) {
                if (rows[m][0] === idHit) { matched = rows[m]; break; }
              }
            }
          }
        }
        if (matched) {
          var id = matched[0], iso = matched[1], co = matched[2], regHint = matched[3], painted = matched[4];
          var fullCo = geoData.full[iso] || co;
          var tradCo = geoData.trad[iso] || "";
          window.__hc = id;
          window.__hcIso = iso;
          window.__hrAutoCountry = { id: id, iso: iso, co: co, fullCo: fullCo, trad: tradCo, isEn: _isEn };
          var sel = document.getElementById("hero-city-select"),
              bg = document.getElementById("hero-city-bg"),
              cn = document.getElementById("hcn"),
              cr = document.getElementById("hcr"),
              cue = document.getElementById("hero-cue-country"),
              c1 = document.getElementById("hero-cta-primary-label"),
              c2 = document.getElementById("hero-cta-secondary-label");
          if (sel) {
            sel.value = id;
            if (_isEn && sel.selectedIndex >= 0) {
              var lbl = sel.options[sel.selectedIndex].text;
              if (cn) cn.textContent = lbl;
              if (cue) cue.textContent = co;
              if (c1) c1.textContent = "Explore " + co + "'s breakthrough";
              if (c2) c2.textContent = "Can " + co + " catch it?";
            }
          }
          if (_isEn && cr) cr.textContent = regHint;
          if (bg) {
            var f = painted ? id : "dawn-sky-base";
            bg.setAttribute("src", (bg.getAttribute("src") || "").replace(/\/assets\/cities\/[^.]+\.webp/, "/assets/cities/" + f + ".webp"));
          }
        }
      } catch (e) {}
    </script>

    <!-- STEP 2: 60-SECOND BREAKTHROUGH EXPLORER & COMPACT 5 LIGHTS -->
    <FiveDoorsPreview client:interact base={base} />

    <!-- STEP 3: COMPACT COUNTRY READINESS SNAPSHOT -->
    <CountryCatchWidget client:interact countries={countryCatalog} base={base} />
    <script is:inline>
      try {
        var _d = window.__hrAutoCountry;
        if (_d && _d.isEn) {
          var dt = document.getElementById("doors-sec-title");
          var ds = document.getElementById("doors-sec-sub");
          if (dt) dt.textContent = _d.trad ? ("From " + _d.co + "'s perspective: " + _d.trad) : ("From " + _d.co + "'s perspective: Test a breakthrough");
          if (ds) ds.textContent = "See what happens when an AI breakthrough meets local reality in " + _d.co + ".";
          var ch = document.getElementById("country-check-heading");
          if (ch) ch.textContent = "Can " + _d.fullCo + " catch it?";
          var csel = document.getElementById("country-select");
          if (csel) {
            for (var i = 0; i < csel.options.length; i++) {
              if (csel.options[i].value === _d.iso) { csel.value = _d.iso; break; }
            }
          }
          if (_d.iso !== "NOR") {
            var box = document.querySelector("#country-check .compact-country-box");
            if (box) {
              var pMsg = box.querySelector(".cc-prepaint-pending");
              if (pMsg) pMsg.textContent = _d.fullCo + " (" + _d.iso + ") detected \u2014 scroll or tap to inspect local safeguard baseline.";
              box.setAttribute("data-prepaint-pending", "true");
            }
          }
        }
      } catch (e) {}
    </script>

    <!-- STEP 4: HUMANITY'S PULSE (Just Above Research Section) -->
    <HumanitysPulseSection client:interact base={base} pulseKey={pulseKey} pulseScore={rawPulseScore} />

    <!-- COMPACT RESEARCH & STORIES BAR -->
    <GoDeeperSection client:interact base={base} />
  </main>

  <HSRIFooter client:interact />
</BaseLayout>

<style>
  .story-canvas {
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    overflow-x: hidden;
  }
</style>
