---
import HSRILayout from '../../layouts/HSRILayout.astro';
import HSRIHeader from '../../components/HSRIHeader.svelte';
import HSRIFooter from '../../components/HSRIFooter.svelte';
import countryScoresData from '../../data/country_scores.json';
import countryProfilesData from '../../data/country_profiles.json';
import { findAnyHeritageForCountry } from '../../lib/heritageLoader';
import { buildCountryWidgetCatalog, type RatedCountrySummary, type UnratedCountrySummary } from '../../lib/countryData';
import {
  buildCountryPageJsonLd,
  getLocalizedCountryNamesAll,
  normalizeCanonicalUrl
} from '../../lib/seo';

export async function getStaticPaths() {
  const { countries } = countryScoresData;
  const catalog = buildCountryWidgetCatalog();
  const catalogByIso = new Map(catalog.map((c) => [c.iso.toUpperCase(), c]));
  const ratedIsoSet = new Set(countries.map((c) => c.code.toUpperCase()));

  const ratedPaths = countries.map((country) => {
    const profile = (countryProfilesData as Record<string, any>)[country.id] || country;
    const cat = catalogByIso.get(country.code.toUpperCase());
    return {
      params: { id: country.id.toLowerCase() },
      props: {
        kind: 'rated' as const,
        country,
        profile,
        ratedSummary: cat?.kind === 'rated' ? (cat as RatedCountrySummary) : null,
        coverageSummary: null
      }
    };
  });

  const coveragePaths = catalog
    .filter((item): item is UnratedCountrySummary => item.kind === 'unrated' && !ratedIsoSet.has(item.iso.toUpperCase()))
    .map((coverageSummary) => ({
      params: { id: coverageSummary.iso.toLowerCase() },
      props: {
        kind: 'coverage' as const,
        country: null,
        profile: null,
        ratedSummary: null,
        coverageSummary
      }
    }));

  return [...ratedPaths, ...coveragePaths];
}

const { kind, country, profile, ratedSummary, coverageSummary } = Astro.props;
const isRated = kind === 'rated' && Boolean(country);

const entityIso = isRated ? country!.code : coverageSummary!.iso;
const entityName = isRated ? (ratedSummary?.name || country!.name) : coverageSummary!.name;
const entityRegion = isRated ? country!.region.replace('-', ' ') : coverageSummary!.region;
const entityId = entityIso.toLowerCase();

const bandColors: Record<string, { bg: string; text: string }> = {
  'A': { bg: '#dcfce7', text: '#166534' },
  'B': { bg: '#dbeafe', text: '#1e40af' },
  'C': { bg: '#fef3c7', text: '#92400e' },
  'D': { bg: '#fee2e2', text: '#991b1b' },
  'F': { bg: '#f1f5f9', text: '#475569' },
};

const bandStyle = isRated ? (bandColors[country!.band] || { bg: '#f1f5f9', text: '#475569' }) : { bg: '#fef3c7', text: '#92400e' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const countryHeritage = findAnyHeritageForCountry(entityIso);

function statusSlug(status: string): string {
  return (status || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

function splitIndicatorList(raw: string): string[] {
  const idx = raw.indexOf(':');
  if (idx < 0) return [];
  return raw
    .slice(idx + 1)
    .replace(/\.$/, '')
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);
}

const observedFlags = !isRated && coverageSummary ? splitIndicatorList(coverageSummary.observedSummary) : [];
const missingFlags = !isRated && coverageSummary ? splitIndicatorList(coverageSummary.missingSummary) : [];

const { byLocale: localizedNames, uniqueNames: alternateNames } = getLocalizedCountryNamesAll(entityIso, entityName);
const canonicalUrl = normalizeCanonicalUrl(Astro.url.href, Astro.url.pathname);
const rawHalfLife = isRated ? (ratedSummary?.tHalfH ?? profile?.simulations?.t_half_h ?? country!.t_half_h) : undefined;
const tHalfH = rawHalfLife !== undefined && rawHalfLife !== null && Number.isFinite(Number(rawHalfLife)) ? Number(rawHalfLife) : undefined;
const halfLifeDesc = tHalfH !== undefined
  ? `, Decoupling Half-Life ${tHalfH}h${ratedSummary?.cloudDaysText ? ` (${ratedSummary.cloudDaysText})` : ''}`
  : '';

const seoTitle = isRated
  ? `${entityName} (${entityIso}) — Humanity Superintelligence Readiness Index (#${country!.rank}/39) | HSRI`
  : `${entityName} (${entityIso}) — AI & Superintelligence Readiness Coverage Audit | HSRI`;

const seoDescription = isRated
  ? `${entityName} ranks #${country!.rank} of 39 in the Humanity Superintelligence Readiness Index (Score ${country!.score}/100, Band ${country!.band}${halfLifeDesc}). Full empirical pillar and indicator audit.`
  : `${entityName} (${entityIso}, ${entityRegion}) is documented in the HSRI global coverage audit and not yet rated in the 39-nation index. ${coverageSummary!.observedSummary} Zero guessed scores.`;

const seoKeywords = [
  `${entityName} superintelligence readiness`,
  `${entityName} AI readiness`,
  `${entityName} Humanity Readiness Index`,
  `Humanity Superintelligence Readiness Index ${entityName}`,
  `HSRI ${entityIso}`,
  ...alternateNames.filter((n) => n !== entityName).slice(0, 8)
].join(', ');

const countryJsonLd = buildCountryPageJsonLd({
  id: entityId,
  iso: entityIso,
  name: entityName,
  region: entityRegion,
  canonicalUrl,
  title: seoTitle,
  description: seoDescription,
  isRated,
  rank: isRated ? country!.rank : undefined,
  score: isRated ? country!.score : undefined,
  band: isRated ? country!.band : undefined,
  tHalfH,
  alternateNames
});
---

<HSRILayout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalUrl={canonicalUrl}
  structuredData={countryJsonLd}
>
  <div class="country-profile-page">
    <HSRIHeader client:load currentPath={Astro.url.pathname} />

    <!-- Breadcrumb & Back navigation -->
    <div class="nav-bar-wrap">
      <div class="container">
        <div class="breadcrumbs">
          <a href={base || '/'}>Home</a> &rsaquo;
          <a href={`${base}/countries/`}>Countries</a> &rsaquo;
          <span>{entityName}</span>
        </div>
      </div>
    </div>

    {isRated && country ? (
      <>
    <!-- Country Hero Header -->
    <header class="profile-hero">
      <div class="container">
        <div class="hero-top">
          <div class="country-identity">
            <span class="country-code-pill">{country.code}</span>
            <h1>{entityName}</h1>
            <span class="region-badge">{country.region.replace('-', ' ').toUpperCase()}</span>
            <span class="status-badge">{country.status}</span>
          </div>

          <div class="rank-score-cluster">
            <div class="stat-cluster-item">
              <span class="label">Benchmark Rank</span>
              <span class="value rank-val">#{country.rank} <small>/ 39</small></span>
            </div>
            <div class="stat-cluster-item">
              <span class="label">Overall Score</span>
              <span class="value score-val">{country.score} <small>/ 100</small></span>
            </div>
            <div class="stat-cluster-item">
              <span class="label">Performance Band</span>
              <span class="band-tag" style={`background-color: ${bandStyle.bg}; color: ${bandStyle.text}`}>
                Band {country.band}
              </span>
            </div>
          </div>
        </div>

        <div class="hero-actions-bar">
          <a href={`${base}/?c=${country.code}`} class="btn btn-primary">
            Explore {entityName} in 60s Explorer &rarr;
          </a>
          <a href={`${base}/compare?countries=${country.code}`} class="btn btn-secondary">
            Compare {entityName} with Peers &rarr;
          </a>
          <a href={`${base}/data`} class="btn btn-secondary">
            Download Country Artifacts (.CSV)
          </a>
        </div>
      </div>
    </header>

    <main class="container profile-body">
      <!-- Executive Summary / Narrative -->
      <section class="section-card narrative-card">
        <h2>Executive Summary & Strategic Position</h2>
        <div class="archetype-badge">
          Archetype: <strong>{country.archetype ? country.archetype.replace('_', ' ').toUpperCase() : 'STRATEGIC ADAPTER'}</strong>
        </div>
        <p class="summary-text">
          {country.executiveSummary || country.summary || `${country.name} enters 2026 with a composite readiness score of ${country.score}/100 and an exposure level of ${country.exposure}/100.`}
        </p>
        {countryHeritage && (
          <div style="margin-top:0.85rem;padding:0.75rem 0.9rem;border-radius:10px;background:var(--bg-surface);border:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.5rem;">
            <div>
              <strong style="color:var(--accent-primary);font-size:0.85rem;">Cultural Horizon · {countryHeritage.traditionLabel.en}:</strong>{' '}
              <span style="font-size:0.85rem;color:var(--text-secondary);">{countryHeritage.chipTitle.en}</span>
            </div>
            <a href={`${base}/traditions/${countryHeritage.slug}/`} style="font-size:0.82rem;font-weight:700;color:var(--accent-primary);text-decoration:none;">
              Read cultural dossier ({countryHeritage.sourceCount} sources) &rarr;
            </a>
          </div>
        )}
      </section>

      <!-- Methodological Callout for Singapore Missingness & Band Sensitivity -->
      {(country.code === 'SGP' || country.id.toLowerCase() === 'sgp') && (
        <section class="section-card methodological-card" id="sgp-methodology-note">
          <div class="methodological-header">
            <span class="info-icon">ℹ️</span>
            <h3>Methodological Note: Missingness &amp; Band Sensitivity</h3>
          </div>
          <div class="methodological-body">
            <p><strong>EMLI score:</strong> Not applicable (European-scope instrument)</p>
            <p><strong>Band assignment:</strong> Uses observed indicators only.</p>
            <p><strong>Imputation sensitivity:</strong> Band A &rarr; B under mean imputation (&Delta; 2.93 pts)</p>
            <p class="methodological-subtext">
              Under HSRI governance rules, structural geographic missingness is never imputed. Imputing European survey instruments for non-European economies would introduce false equivalence between regional survey participation and general cognitive discernment.
            </p>
          </div>
        </section>
      )}

      <!-- 4 Pillars Breakdown -->
      <section class="section-card">
        <div class="section-title-wrap">
          <h2>Core Readiness Pillars</h2>
          <p class="subtitle">Non-compensatory evaluation across the four primary preparedness domains</p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-card">
            <div class="pillar-top">
              <span class="p-icon" style="background: #eff6ff; color: #2563eb;">📚</span>
              <span class="p-score">{country.pillars.ai_literacy}%</span>
            </div>
            <h3>AI Literacy</h3>
            <p class="p-desc">Workforce comprehension, secondary educational integration, and generative model technical fluency.</p>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${country.pillars.ai_literacy}%; background: #3b82f6;`}></div>
            </div>
          </div>

          <div class="pillar-card">
            <div class="pillar-top">
              <span class="p-icon" style="background: #f5f3ff; color: #7c3aed;">🛡️</span>
              <span class="p-score">{country.pillars.critical_discernment}%</span>
            </div>
            <h3>Critical Discernment</h3>
            <p class="p-desc">Cognitive resilience against synthetic disinformation, epistemic erosion, and deepfake deception.</p>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${country.pillars.critical_discernment}%; background: #8b5cf6;`}></div>
            </div>
          </div>

          <div class="pillar-card">
            <div class="pillar-top">
              <span class="p-icon" style="background: #ecfdf5; color: #059669;">⚖️</span>
              <span class="p-score">{country.pillars.institutional_governance}%</span>
            </div>
            <h3>Institutional Governance</h3>
            <p class="p-desc">State regulatory enforceability, third-party model audit capacity, and adaptive oversight agility.</p>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${country.pillars.institutional_governance}%; background: #10b981;`}></div>
            </div>
          </div>

          <div class="pillar-card">
            <div class="pillar-top">
              <span class="p-icon" style="background: #fffbeb; color: #d97706;">⚡</span>
              <span class="p-score">{country.pillars.digital_infrastructure}%</span>
            </div>
            <h3>Digital Infrastructure</h3>
            <p class="p-desc">Sovereign compute density, high-speed fiber penetration, clean power redundancy, and grid resilience.</p>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${country.pillars.digital_infrastructure}%; background: #f59e0b;`}></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Exposure, Labor, & Timeline Crossing Horizons -->
      <section class="two-col-grid">
        <!-- Exposure & Deficit Analysis -->
        <div class="section-card">
          <h2>Exposure & Deficit Analysis</h2>
          <div class="metric-row">
            <span class="m-label">Macro AI Exposure Score</span>
            <span class="m-val">{country.exposure} / 100</span>
          </div>
          <div class="metric-row">
            <span class="m-label">Readiness-Exposure Gap</span>
            <span class={`m-val ${country.gap > 0 ? 'gap-deficit' : 'gap-surplus'}`}>
              {country.gap > 0 ? `+${country.gap}` : country.gap} ({country.gapStatus})
            </span>
          </div>
          <div class="metric-row">
            <span class="m-label">Labor Market Vulnerability</span>
            <span class="m-val">{country.laborVulnerability}%</span>
          </div>
          <div class="metric-row">
            <span class="m-label">Estimated Labor Crossing Year</span>
            <span class="m-val highlight-val">{country.laborCrossingYear}</span>
          </div>
        </div>

        <!-- Capability Crossing Scenarios -->
        <div class="section-card">
          <h2>Superintelligence Crossing Scenarios</h2>
          <p class="scenario-intro">Year in which external AI capabilities exceed domestic absorption & governance capacity:</p>
          <div class="scenario-item">
            <div class="s-info">
              <span class="s-name">Takeoff Scenario</span>
              <span class="s-desc">Accelerated recursion & fast-takeoff AGI</span>
            </div>
            <span class="s-year">{country.crossingYears.takeoff ? country.crossingYears.takeoff : 'Post-2045'}</span>
          </div>
          <div class="scenario-item highlight-item">
            <div class="s-info">
              <span class="s-name">Steady Progress (Baseline)</span>
              <span class="s-desc">Historical tech adoption curves</span>
            </div>
            <span class="s-year">{country.crossingYears.steady ? country.crossingYears.steady : 'Post-2045'}</span>
          </div>
          <div class="scenario-item">
            <div class="s-info">
              <span class="s-name">Plateau Scenario</span>
              <span class="s-desc">Hardware bottlenecks & algorithmic slowdown</span>
            </div>
            <span class="s-year">{country.crossingYears.plateau ? country.crossingYears.plateau : 'Post-2045'}</span>
          </div>
        </div>
      </section>

      <!-- Strengths & Challenges -->
      <section class="two-col-grid">
        <div class="section-card">
          <h3 class="card-subtitle green-text">Key Strengths & Advantages</h3>
          <ul class="bullet-list green-bullets">
            {country.strengths && country.strengths.length > 0 ? (
              country.strengths.map((s: string) => <li>{s}</li>)
            ) : (
              <li>High-capacity institutional stability</li>
              <li>Advanced domestic digital connectivity</li>
              <li>Active participation in multilateral AI safety standards</li>
            )}
          </ul>
        </div>

        <div class="section-card">
          <h3 class="card-subtitle red-text">Strategic Challenges & Vulnerabilities</h3>
          <ul class="bullet-list red-bullets">
            {country.challenges && country.challenges.length > 0 ? (
              country.challenges.map((c: string) => <li>{c}</li>)
            ) : (
              <li>High automation exposure across white-collar knowledge sectors</li>
              <li>Pace of model deployment outpacing regulatory feedback loops</li>
              <li>Cognitive defense deficits in public epistemic verification</li>
            )}
          </ul>
        </div>
      </section>

      <!-- Strategic Policy Recommendations -->
      {country.recommendations && country.recommendations.length > 0 && (
        <section class="section-card">
          <h2>Policy & Strategic Recommendations</h2>
          <div class="recommendations-grid">
            {country.recommendations.map((rec: string, index: number) => (
              <div class="rec-item">
                <span class="rec-idx">0{index + 1}</span>
                <p>{rec}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Indicator Audit & Empirical Provenance (Task 5) -->
      <section class="section-card indicator-audit-card">
        <div class="audit-header">
          <div>
            <h2>Indicator Audit &amp; Data Provenance</h2>
            <p class="subtitle">Empirical completeness for {country.name}: <strong>{country.coverage}%</strong> ({country.observedCount}/{country.totalRetained} retained indicators observed). Missing indicators are omitted from pillar scoring via proportional weight re-scaling.</p>
          </div>
          <span class="audit-badge">Phase 2 Ingestion v0.2.1</span>
        </div>

        <div class="table-responsive">
          <table class="audit-table">
            <thead>
              <tr>
                <th>Code</th>
                <th>Indicator Name</th>
                <th>Pillar</th>
                <th>Role</th>
                <th>Observed Value</th>
                <th>Empirical Status for {country.code}</th>
                <th>Provenance &amp; Notes</th>
              </tr>
            </thead>
            <tbody>
              {country.indicatorsBreakdown && country.indicatorsBreakdown.length > 0 ? (
                country.indicatorsBreakdown.map((ind: any) => {
                  const slug = statusSlug(ind.auditStatus);
                  const isMissing = ind.auditStatus.toLowerCase().indexOf('missing') !== -1;
                  const isRejected = ind.auditStatus.toLowerCase().indexOf('rejected') !== -1;
                  const rowClass = isMissing ? 'imputed' : isRejected ? 'rejected' : 'observed';
                  return (
                    <tr class={`status-row-${rowClass}`}>
                      <td class="font-mono"><code>{ind.code}</code></td>
                      <td class="ind-name"><strong>{ind.name}</strong></td>
                      <td><span class="pillar-tag">{ind.pillar.replace('_', ' ')}</span></td>
                      <td><span class={`role-pill role-${ind.role.toLowerCase()}`}>{ind.role}</span></td>
                      <td class="font-mono">{ind.rawValue !== null && ind.rawValue !== undefined ? ind.rawValue : <span style="color: #94a3b8;">&mdash;</span>}</td>
                      <td>
                        <span class={`audit-status-tag status-${slug}`}>
                          {ind.auditStatus}
                        </span>
                      </td>
                      <td class="audit-note-text">{ind.auditNote}</td>
                    </tr>
                  );
                })
              ) : (
                <tr>
                  <td colspan="6" style="text-align: center; color: #64748b; padding: 2rem;">
                    Full indicator-level microdata audit available in repository <code>data/observations.csv</code>.
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section-card">
        <h2>{entityName} Across 14 Global Languages</h2>
        <p class="subtitle" style="margin-bottom: 1rem;">
          Official regional names and multilingual search identifiers indexed in the Humanity Superintelligence Readiness Observatory.
        </p>
        <div class="locale-names-grid">
          {localizedNames.map((entry) => (
            <a href={entry.loc === 'en' ? `${base}/?c=${entityIso}` : `${base}/${entry.loc}/?c=${entityIso}`} class="locale-name-chip">
              <span class="ln-lang">{entry.label}</span>
              <strong class="ln-val">{entry.name}</strong>
            </a>
          ))}
        </div>
      </section>
    </main>
      </>
    ) : coverageSummary ? (
      <>
    <header class="profile-hero">
      <div class="container">
        <div class="hero-top">
          <div class="country-identity">
            <span class="country-code-pill">{coverageSummary.iso}</span>
            <h1>{coverageSummary.name}</h1>
            <span class="region-badge">{coverageSummary.region.toUpperCase()}</span>
            <span class="status-badge coverage-status-badge">Coverage Audit · Not Yet Rated</span>
          </div>

          <div class="rank-score-cluster">
            <div class="stat-cluster-item">
              <span class="label">39-Nation Index</span>
              <span class="value" style="font-size:1.35rem;">Not Yet Rated</span>
            </div>
            <div class="stat-cluster-item">
              <span class="label">Imputation Policy</span>
              <span class="value" style="font-size:1.35rem;">Never Guessed</span>
            </div>
            <div class="stat-cluster-item">
              <span class="label">Audit Basis</span>
              <span class="band-tag" style="background-color:#fef3c7;color:#92400e;">Empirical Coverage</span>
            </div>
          </div>
        </div>

        <div class="hero-actions-bar">
          <a href={`${base}/?c=${coverageSummary.iso}`} class="btn btn-primary">
            Explore {coverageSummary.name} in 60s Explorer &rarr;
          </a>
          <a href={`${base}/coverage/`} class="btn btn-secondary">
            Help Rate {coverageSummary.name} &middot; Coverage Audit &rarr;
          </a>
          <a href={`${base}/countries/`} class="btn btn-secondary">
            Compare 39 Benchmark Nations &rarr;
          </a>
        </div>
      </div>
    </header>

    <main class="container profile-body">
      <section class="section-card narrative-card">
        <h2>Epistemic Status &mdash; {coverageSummary.name} ({coverageSummary.iso})</h2>
        <div class="archetype-badge">
          Status: <strong>Coverage Audit Only (Rule R6 Non-Imputation)</strong>
        </div>
        <p class="summary-text">
          {coverageSummary.name} is documented in the HSRI global coverage dataset, but is not yet assigned a composite rank or numeric readiness score in the 39-nation benchmark. HSRI strictly avoids fabricating missing human-readiness indicators via regional averages or synthetic proxies.
        </p>
        {countryHeritage && (
          <div style="margin-top:0.85rem;padding:0.75rem 0.9rem;border-radius:10px;background:var(--bg-surface);border:1px solid var(--border-subtle);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:0.5rem;">
            <div>
              <strong style="color:var(--accent-primary);font-size:0.85rem;">Cultural Horizon · {countryHeritage.traditionLabel.en}:</strong>{' '}
              <span style="font-size:0.85rem;color:var(--text-secondary);">{countryHeritage.chipTitle.en}</span>
            </div>
            <a href={`${base}/traditions/${countryHeritage.slug}/`} style="font-size:0.82rem;font-weight:700;color:var(--accent-primary);text-decoration:none;">
              Read cultural dossier ({countryHeritage.sourceCount} sources) &rarr;
            </a>
          </div>
        )}
      </section>

      <section class="two-col-grid" style="margin-bottom: 2rem;">
        <div class="section-card" style="margin-bottom: 0;">
          <h2>Observed Empirical Signals</h2>
          <p class="subtitle" style="margin-bottom: 1rem;">{coverageSummary.observedSummary}</p>
          {observedFlags.length > 0 && (
            <div class="cov-flags-wrap">
              {observedFlags.map((flag) => (
                <span class="cov-flag-pill is-observed">{flag}</span>
              ))}
            </div>
          )}
          <p style="margin-top: 1rem; font-size: 0.9rem; color: #475569; line-height: 1.55;">
            {coverageSummary.coverageDetail}
          </p>
        </div>

        <div class="section-card" style="margin-bottom: 0;">
          <h2>Missing Coverage Indicators</h2>
          <p class="subtitle" style="margin-bottom: 1rem;">{coverageSummary.missingSummary}</p>
          {missingFlags.length > 0 && (
            <div class="cov-flags-wrap">
              {missingFlags.map((flag) => (
                <span class="cov-flag-pill is-missing">{flag}</span>
              ))}
            </div>
          )}
          <div style="margin-top: 1.25rem;">
            <a href={`${base}/coverage/`} class="btn btn-primary" style="display:inline-block;">
              Contribute Verified National Sources &rarr;
            </a>
          </div>
        </div>
      </section>

      <section class="section-card">
        <h2>{coverageSummary.name} Across 14 Global Languages</h2>
        <p class="subtitle" style="margin-bottom: 1rem;">
