---
import HSRILayout from '../layouts/HSRILayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
import SovereignObservatory from '../components/SovereignObservatory.svelte';
import CountryList from '../components/CountryList.svelte';
import scoresData from '../data/country_scores.json';
import { buildCountryWidgetCatalog, type RatedCountrySummary, type UnratedCountrySummary } from '../lib/countryData';
import { normalizeCanonicalUrl } from '../lib/seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const meta = (scoresData as any).metadata ?? {};
const allCatalog = buildCountryWidgetCatalog();
const ratedDirectory = allCatalog.filter((c): c is RatedCountrySummary => c.kind === 'rated').sort((a, b) => a.rank - b.rank);
const coverageDirectory = allCatalog.filter((c): c is UnratedCountrySummary => c.kind === 'unrated').sort((a, b) => a.name.localeCompare(b.name));
const canonicalUrl = normalizeCanonicalUrl(Astro.url.href, Astro.url.pathname);
---

<HSRILayout
  title="All 148 Countries — Humanity Superintelligence Readiness Index | HSRI"
  description="Browse all 39 rated benchmark nations and 109 empirical coverage-audit countries in the Humanity Superintelligence Readiness Index (HSRI)."
  keywords="Humanity Superintelligence Readiness Index countries, AI readiness country ranking, 39-nation benchmark, 148 country coverage audit, HSRI"
  canonicalUrl={canonicalUrl}
>
  <div class="countries-page">
    <HSRIHeader client:load currentPath={Astro.url.pathname} />

    <div class="page-header">
      <div class="container">
        <div class="eyebrow">39-NATION SOVEREIGN DECOUPLING OBSERVATORY</div>
        <h1>Country Index</h1>
        <p class="subtitle">
          Interactive planetary mapping of sovereign resilience under zero-notice cloud severance. Select any nation on the globe to inspect its Decoupling Half-Life and weakest-link floor.
        </p>
        <div class="head-meta">
          <span>HSRI Research Consortium</span>
          <span>·</span>
          <a href="https://doi.org/10.5281/zenodo.23441742" target="_blank" rel="noopener noreferrer">DOI 10.5281/zenodo.23441742</a>
          <span>·</span>
          <span>{meta.methodologyVersion ?? 'v2.0-dual-layer'} · {scoresData.countries.length} benchmark nations</span>
        </div>
      </div>
    </div>

    <div class="container observatory" id="observatory">
      <!-- Dual-View Switcher -->
      <div class="view-switcher" role="tablist" aria-label="View toggle">
        <button type="button" class="switch-btn active" data-view="globe" role="tab" aria-selected="true">
          🌐 3D Interactive Globe
        </button>
        <button type="button" class="switch-btn" data-view="matrix" role="tab" aria-selected="false">
          📊 Sovereign Scoreboard Matrix
        </button>
      </div>

      <!-- GLOBE OBSERVATORY VIEW (default) -->
      <section class="view view-globe active" data-view="globe" role="tabpanel">
        <SovereignObservatory client:visible countries={scoresData.countries} />
      </section>

      <!-- MATRIX VIEW (dense comparative scoreboard) -->
      <section class="view view-matrix" data-view="matrix" role="tabpanel" hidden>
        <CountryList client:idle />
      </section>
    </div>

    <section class="container all-nations-directory" aria-labelledby="all-nations-heading">
      <div class="dir-header">
        <h2 id="all-nations-heading">Complete 148-Country Directory</h2>
        <p>Direct empirical dossiers for all 39 benchmark-rated nations and 109 honest non-imputed coverage audits.</p>
      </div>

      <div class="dir-block">
        <h3>39-Nation Benchmark Profiles ({ratedDirectory.length})</h3>
        <div class="dir-grid">
          {ratedDirectory.map((c) => (
            <a href={`${base}/countries/${c.id.toLowerCase()}/`} class="dir-chip is-rated">
              <span class="dir-rank">#{c.rank}</span>
              <span class="dir-name">{c.name}</span>
              <span class="dir-iso">{c.iso}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="dir-block">
        <h3>Global Empirical Coverage Audits — Not Yet Rated ({coverageDirectory.length})</h3>
        <div class="dir-grid">
          {coverageDirectory.map((c) => (
            <a href={`${base}/countries/${c.iso.toLowerCase()}/`} class="dir-chip is-coverage">
              <span class="dir-name">{c.name}</span>
              <span class="dir-iso">{c.iso}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <HSRIFooter />
  </div>

  <script>
    // Dual-view toggle (vanilla, zero framework cost, preserves SSR)
    const btns = document.querySelectorAll<HTMLButtonElement>('.switch-btn');
    const views = document.querySelectorAll<HTMLElement>('.view');
    btns.forEach(b =>
      b.addEventListener('click', () => {
        const v = b.dataset.view;
        btns.forEach(x => {
          const isActive = x.dataset.view === v;
          x.classList.toggle('active', isActive);
          x.setAttribute('aria-selected', String(isActive));
        });
        views.forEach(s => {
          const active = s.dataset.view === v;
          s.classList.toggle('active', active);
          if (active) {
            s.removeAttribute('hidden');
          } else {
            s.setAttribute('hidden', '');
          }
        });
        document.getElementById('observatory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      })
    );
  </script>

  <style>
    .countries-page {
      min-height: 100vh;
      background: var(--bg-canvas);
      color: var(--text-primary);
    }
    .page-header {
      text-align: center;
      padding: 2.2rem 1.25rem 1.6rem;
      background: radial-gradient(900px 400px at 50% 0%, var(--accent-primary-glow), transparent 60%),
        linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-sunken) 100%);
      border-bottom: 1px solid var(--border-subtle);
    }
    .eyebrow {
      display: inline-block;
      font-family: var(--font-family-mono);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--accent-primary);
      background: var(--threat-telemetry-bg);
      border: 1px solid var(--threat-telemetry-border);
      padding: 4px 12px;
      border-radius: 9999px;
      margin-bottom: 12px;
    }
    .page-header h1 {
      font-size: clamp(1.9rem, 3.2vw, 2.6rem);
      font-weight: 900;
      letter-spacing: -0.03em;
      color: var(--text-primary);
      margin: 0 0 10px 0;
    }
    .subtitle {
      max-width: 720px;
      margin: 0 auto 12px auto;
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.55;
    }
    .head-meta {
      font-family: var(--font-family-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }
    .head-meta a {
      color: var(--accent-primary);
      text-decoration: none;
    }
    .head-meta a:hover {
      text-decoration: underline;
    }
    .container {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 1rem;
    }
    .observatory {
      padding: 18px 0 40px 0;
    }
    .view-switcher {
      display: flex;
      gap: 6px;
      justify-content: flex-end;
      margin-bottom: 16px;
      background: var(--bg-surface-sunken);
      border: 1px solid var(--border-subtle);
      padding: 4px;
      border-radius: 12px;
      width: fit-content;
      margin-left: auto;
    }
    .switch-btn {
      padding: 8px 16px;
      border-radius: 9px;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .switch-btn.active {
      background: var(--bg-surface-elevated);
      color: var(--text-primary);
      border-color: var(--border-subtle);
      box-shadow: var(--shadow-sm);
    }
    .view {
      display: none;
    }
    .view.active {
      display: block;
    }
    @media (max-width: 980px) {
      .view-switcher {
        width: 100%;
        box-sizing: border-box;
      }
      .switch-btn {
        flex: 1;
        text-align: center;
      }
    }
    @media (max-width: 768px) {
      .head-meta {
        font-size: 0.68rem;
      }
    }

    .all-nations-directory {
      padding: 1rem 0 3.5rem;
    }
    .dir-header h2 {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text-primary, #0f172a);
      margin-bottom: 0.3rem;
    }
    .dir-header p {
      font-size: 0.92rem;
      color: var(--text-secondary, #475569);
      margin-bottom: 1.5rem;
    }
    .dir-block {
      margin-bottom: 2rem;
    }
    .dir-block h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-secondary, #334155);
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .dir-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 0.55rem;
    }
    .dir-chip {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      background: var(--bg-surface-elevated, #ffffff);
      border: 1px solid var(--border-subtle, #e2e8f0);
      text-decoration: none;
      color: var(--text-primary, #0f172a);
      font-size: 0.85rem;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .dir-chip:hover {
      border-color: var(--accent-primary, #1b6756);
      transform: translateY(-1px);
    }
    .dir-rank {
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--accent-primary, #1b6756);
      font-family: ui-monospace, monospace;
    }
    .dir-name {
      flex: 1;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .dir-iso {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted, #64748b);
      font-family: ui-monospace, monospace;
    }
  </style>
</HSRILayout>
