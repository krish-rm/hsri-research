---
import HSRILayout from '../layouts/HSRILayout.astro';
import HSRIHeader from '../components/HSRIHeader.svelte';
import PrecursorSeismograph from '../components/PrecursorSeismograph.svelte';
import HSRIFooter from '../components/HSRIFooter.svelte';
---

<HSRILayout title="ASI Precursor Seismograph & Sovereignty Sentinel — HSRI Benchmark">
  <div class="seismograph-page">
    <HSRIHeader client:load currentPath={Astro.url.pathname} />

    <div class="page-intro container">
      <div class="breadcrumb">
        <a href="/">Home</a> &rsaquo; <span>Precursor Seismograph</span>
      </div>
    </div>

    <main class="page-content container">
      <PrecursorSeismograph client:load />
    </main>

    <HSRIFooter client:load />
  </div>
</HSRILayout>

<style>
  .seismograph-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-canvas);
    color: var(--text-primary);
  }

  .container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 1.25rem;
    width: 100%;
  }

  .page-intro {
    padding-top: 1.5rem;
    padding-bottom: 0.5rem;
  }

  .breadcrumb {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .breadcrumb a {
    color: var(--accent-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .page-content {
    flex: 1;
    padding-bottom: 4rem;
  }
</style>
